---
import { Icon } from "astro-icon/components";
import SectionHeading from "../common/section-heading.astro";
import localData from "../../data/contact.json";
---

<section id="contact" class="px-6 py-16">
  <div class="container mx-auto">
    <SectionHeading title="Contact" />
    <p
      class="text-gray-400 font-body text-sm mb-12 -mt-4"
      set:html={localData.descHtml}
    />

    <div class="flex flex-wrap justify-center gap-6 my-8">
      {
        localData.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            class="flex flex-col items-center gap-2 p-6 border border-white/10 rounded-xl hover:border-accent/40 transition-colors w-60 bg-white/5"
          >
            <Icon name={social.icon} class="w-8 h-8 text-accent" />
            <span class="text-sm font-bold">{social.name}</span>
            <span class="text-xs text-gray-400">
              {social.url.replace("https://", "").replace("mailto:", "")}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
