---
import { Icon } from "astro-icon/components";
import SectionHeading from "../common/section-heading.astro";

interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  job: string;
  introHtml: string;
  blogUrl: string;
  socials: Social[];
}

interface Props {
  data: ProfileData;
}

const { data: profileData } = Astro.props;
---

<section id="about">
  <div
    class="bg-background-sub/50 mx-auto my-16 w-[97.5%] max-w-7xl rounded-2xl border border-white/10 px-4 pt-6 pb-8 backdrop-blur-2xl backdrop-saturate-200 sm:px-6 sm:pt-8 sm:pb-10"
  >
    <div class="container mx-auto">
      <SectionHeading title="About Me" />

      <div
        class="flex-col items-center justify-center py-8 text-center sm:py-12"
      >
        <div
          class="mx-auto w-40 overflow-hidden rounded-full sm:w-56 md:w-72 lg:w-80"
        >
          <img
            src={profileData.photoUrl}
            alt={profileData.name}
            onerror="this.onerror=null;this.src='/placeholder.jpeg';"
          />
        </div>

        <div>
          <h1 class="my-4 text-3xl sm:text-4xl md:text-5xl">
            {profileData.name}
          </h1>
          <div class="m-4 my-4 text-sm text-gray-300 sm:text-base md:text-xl">
            {profileData.job}
          </div>
          <div
            class="mx-4 mt-2 mb-4 text-[11px] leading-relaxed text-gray-300 md:text-sm"
            set:html={profileData.introHtml}
          />
        </div>

        <div class="reveal-content my-8 flex justify-center gap-6">
          {
            profileData.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                class="group relative flex flex-col items-center justify-center transition-all hover:scale-105"
              >
                <Icon
                  name={social.icon}
                  class="group-hover:text-accent h-8 w-8 text-white transition-colors duration-300 sm:h-12 sm:w-12"
                />
                <span class="text-accent font-body absolute -bottom-6 scale-0 text-xs opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100">
                  {social.name}
                </span>
              </a>
            ))
          }
        </div>

        <div
          class="reveal-content mt-8 mb-2 flex justify-center"
          style="animation-delay: 0.2s"
        >
          <a
            href={profileData.blogUrl}
            target="_blank"
            class="group flex items-center gap-2 transition-all duration-300 hover:scale-105 sm:gap-3"
          >
            <img
              src="/img/icon/elekibear-white.png"
              alt="TECH BLOG"
              class="h-9 w-9 sm:h-12 sm:w-12"
            />
            <span
              class="group-hover:text-accent font-body text-xl text-gray-200 transition-colors duration-300 sm:text-2xl"
            >
              TECH BLOG
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
