---
import { Icon } from "astro-icon/components";
import data from "../../data/about.json";
import SectionHeading from "../common/section-heading.astro";

interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  job: string;
  introHtml: string;
  blogUrl: string;
  socials: Social[];
}

const profileData: ProfileData = data;
---

<section id="about">
  <div
    class="px-4 sm:px-6 pt-6 sm:pt-8 pb-12 sm:pb-16 bg-background-sub/50 backdrop-blur-2xl backdrop-saturate-200 border border-white/10 w-[97.5%] max-w-[1280px] mx-auto my-16 rounded-2xl"
  >
    <div class="container mx-auto">
      <SectionHeading title="About Me" />

      <div
        class="flex-col items-center justify-center py-8 sm:py-12 text-center"
      >
        <div
          class="rounded-full overflow-hidden w-40 sm:w-56 md:w-72 lg:w-80 mx-auto"
        >
          <img
            src={profileData.photoUrl}
            alt={profileData.name}
            onerror="this.onerror=null;this.src='/placeholder.jpeg';"
          />
        </div>

        <div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl my-4">
            {profileData.name}
          </h1>
          <div class="m-4 text-gray-300 text-sm sm:text-base md:text-xl my-4">
            {profileData.job}
          </div>
          <div
            class="mx-4 mt-2 mb-4 text-gray-300 text-[11px] md:text-sm leading-relaxed"
            set:html={profileData.introHtml}
          />
        </div>

        <div class="flex justify-center gap-6 my-8 reveal-content">
          {
            profileData.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                class="group relative flex flex-col items-center justify-center transition-all hover:scale-105"
              >
                <Icon
                  name={social.icon}
                  class="w-8 h-8 sm:w-12 sm:h-12 text-white group-hover:text-accent transition-colors duration-300"
                />
                <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
                  {social.name}
                </span>
              </a>
            ))
          }
        </div>

        <div
          class="flex justify-center mt-8 mb-2 reveal-content"
          style="animation-delay: 0.2s"
        >
          <a
            href={profileData.blogUrl}
            target="_blank"
            class="group flex items-center gap-2 sm:gap-3 transition-all duration-300 hover:scale-105"
          >
            <img
              src="/img/icon/elekibear-white.png"
              alt="TECH BLOG"
              class="w-9 h-9 sm:w-12 sm:h-12"
            />
            <span
              class="text-gray-200 group-hover:text-accent transition-colors duration-300 font-body text-xl sm:text-2xl"
            >
              TECH BLOG
            </span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
