---
import { Icon } from "astro-icon/components";
import type { Locale } from "../../lib/data-loader";
import type { GalleryData } from "../../types/data/gallery";
import Layout from "../../layouts/layout.astro";
import Header from "../sections/header.astro";
import Footer from "../sections/footer.astro";
import SectionCard from "../common/section-card.astro";
import SectionHeading from "../common/section-heading.astro";

interface Props {
  locale: Locale;
  data: GalleryData;
}

const { data } = Astro.props;

function getMusicThumbnail(item: GalleryData.Item): string {
  if (item.image) {
    return item.image;
  }
  if (item.embedUrl) {
    const match = item.embedUrl.match(/embed\/([^?]+)/);
    if (match) {
      return `https://img.youtube.com/vi/${match[1]}/hqdefault.jpg`;
    }
  }
  return "https://placehold.co/400x400/1a1a2e/a0a0c0?text=Music";
}

// 動画項目は embedUrl から YouTube 視聴リンクを自動生成し、他サービスのリンクと並べる。
function getItemLinks(item: GalleryData.Item): GalleryData.Link[] {
  const links = item.links ? [...item.links] : [];
  if (item.embedType === "video" && item.embedUrl) {
    const match = item.embedUrl.match(/embed\/([^?&]+)/);
    if (match) {
      links.push({
        icon: "fa-brands:youtube",
        tooltip: "YouTube",
        href: `https://www.youtube.com/watch?v=${match[1]}`,
      });
    }
  }
  return links;
}
---

<Layout>
  <Header />
  <main class="min-h-screen">
    <SectionCard id="gallery-page" class="px-6 pb-24">
      <SectionHeading title="Gallery" />
      <p
        class="font-body -mt-4 mb-12 text-xs leading-relaxed text-gray-300 sm:text-sm md:text-base"
        set:html={data.allDescHtml}
      />

      <!-- Tab buttons -->
      <div class="mb-12 flex gap-3">
        {
          data.categories.map((category, index) => (
            <button
              class="gallery-tab rounded-full px-7 py-3 text-sm font-medium tracking-[0.08em] uppercase transition-all duration-200"
              data-tab={category.type}
              data-active={index === 0 ? "true" : "false"}
            >
              {category.label}
            </button>
          ))
        }
      </div>

      <!-- Tab contents -->
      {
        data.categories.map((category, categoryIndex) => (
          <div
            class="gallery-tab-content"
            data-tab={category.type}
            style={categoryIndex !== 0 ? "display:none" : ""}
          >
            <div class="space-y-16">
              {category.sections.map((section) => (
                <div>
                  <h3 class="font-heading text-accent mb-3 border-b border-white/10 pb-3 text-lg font-semibold tracking-widest uppercase">
                    {section.section}
                  </h3>
                  {section.descHtml && (
                    <p
                      class:list={[
                        "font-body text-xs leading-relaxed text-gray-400 sm:text-sm",
                        section.link ? "mb-4" : "mb-8",
                      ]}
                      set:html={section.descHtml}
                    />
                  )}
                  {section.link && (
                    <div class="mb-6">
                      <a
                        href={section.link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:border-accent/60 hover:text-accent font-body inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-5 py-2.5 text-xs font-semibold tracking-wider text-white/80 transition-colors duration-300"
                      >
                        <Icon name={section.link.icon} class="h-4 w-4" />
                        {section.link.label}
                      </a>
                    </div>
                  )}

                  {category.type === "music" ? (
                    <div class="space-y-6">
                      {section.items.map((item) => (
                        <div
                          class="gallery-card bg-background-sub/70 hover:border-accent/40 overflow-hidden rounded-2xl border border-white/10 transition-[border-color] duration-500"
                          style={
                            item.maxWidth ? { maxWidth: item.maxWidth } : {}
                          }
                        >
                          {item.embedType === "video" ? (
                            <div class="relative aspect-video w-full">
                              <button
                                class="video-facade group/video absolute inset-0 h-full w-full cursor-pointer"
                                data-embed-url={item.embedUrl}
                                aria-label={`Play ${item.title}`}
                              >
                                <img
                                  src={getMusicThumbnail(item)}
                                  alt={item.title}
                                  loading="lazy"
                                  class="absolute inset-0 h-full w-full object-cover"
                                />
                                <span class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors duration-200 group-hover/video:bg-black/30">
                                  {/* is:inline: 共有 <symbol> 参照だと最初の動画カードが
                                      iframe に置換された際に他の再生アイコンも消えるため */}
                                  <Icon
                                    name="mdi:play-circle"
                                    is:inline
                                    class="h-16 w-16 text-white/90 drop-shadow-lg transition-transform duration-200 group-hover/video:scale-110"
                                  />
                                </span>
                              </button>
                            </div>
                          ) : item.embedType === "apple-music-player" ? (
                            <div class="w-full overflow-hidden">
                              <iframe
                                src={item.embedUrl}
                                title={item.title}
                                class="w-full border-0"
                                style={{ height: "450px" }}
                                allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
                                sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
                              />
                            </div>
                          ) : (
                            <div class="bg-background overflow-hidden">
                              <img
                                src={getMusicThumbnail(item)}
                                alt={item.title}
                                loading="lazy"
                                class="h-auto w-full"
                              />
                            </div>
                          )}
                          <div class="p-5">
                            <p class="font-body text-xs tracking-wide text-white/40">
                              {item.year}
                            </p>
                            <h4 class="font-heading mt-1 text-base font-bold text-white sm:text-lg">
                              {item.title}
                            </h4>
                            {item.description && (
                              <p class="font-body mt-2 text-xs text-gray-400 sm:text-sm">
                                {item.description}
                              </p>
                            )}
                            {getItemLinks(item).length > 0 && (
                              <div class="mt-4 flex gap-3">
                                {getItemLinks(item).map((link) => (
                                  <div class="group/tip relative">
                                    <a
                                      href={link.href}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="hover:text-accent block text-white/65 transition-colors"
                                    >
                                      <Icon name={link.icon} class="h-6 w-6" />
                                    </a>
                                    <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded bg-black/80 px-2 py-1 text-[10px] whitespace-nowrap text-white opacity-0 transition-opacity duration-200 group-hover/tip:opacity-100">
                                      {link.tooltip}
                                    </span>
                                  </div>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="space-y-6">
                      {section.items.map((item) => {
                        const image =
                          item.image ??
                          "https://placehold.co/400x500/1a1a2e/a0a0c0?text=Illustration";
                        return (
                          <div
                            class="gallery-card bg-background-sub/70 hover:border-accent/40 overflow-hidden rounded-2xl border border-white/10 transition-[border-color] duration-500"
                            style={
                              item.maxWidth ? { maxWidth: item.maxWidth } : {}
                            }
                          >
                            <div class="bg-background overflow-hidden">
                              <img
                                src={image}
                                alt={item.title}
                                loading="lazy"
                                class="h-auto w-full"
                              />
                            </div>
                            <div class="p-4">
                              <p class="font-body text-[10px] tracking-wide text-white/40">
                                {item.year}
                              </p>
                              <h4 class="font-heading mt-0.5 text-sm font-bold text-white sm:text-base">
                                {item.title}
                              </h4>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </SectionCard>
  </main>
  <Footer />
</Layout>

<style>
  .gallery-tab {
    color: rgba(156, 163, 175, 1);
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .gallery-tab[data-active="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .gallery-tab:not([data-active="true"]):hover {
    color: white;
    border-color: rgba(255, 255, 255, 0.5);
  }
</style>

<script>
  import {
    initializeGalleryReveal,
    initializeVideoFacades,
  } from "../../lib/gallery-media";

  function activateTab(tabType: string) {
    const tabs = document.querySelectorAll(
      ".gallery-tab",
    ) as NodeListOf<HTMLElement>;
    const contents = document.querySelectorAll(
      ".gallery-tab-content",
    ) as NodeListOf<HTMLElement>;
    tabs.forEach((tab) => {
      tab.dataset.active = tab.dataset.tab === tabType ? "true" : "false";
    });
    contents.forEach((content) => {
      content.style.display = content.dataset.tab === tabType ? "" : "none";
    });
  }

  function applyTabFromHash() {
    const hash = window.location.hash.slice(1);
    const tabs = document.querySelectorAll(
      ".gallery-tab",
    ) as NodeListOf<HTMLElement>;
    const validTabs = Array.from(tabs).map((tab) => tab.dataset.tab);
    if (hash && validTabs.includes(hash)) {
      activateTab(hash);
    }
  }

  function initTabs() {
    const tabs = document.querySelectorAll(
      ".gallery-tab",
    ) as NodeListOf<HTMLElement>;
    tabs.forEach((tab) => {
      if (tab.dataset.clickBound === "true") {
        return;
      }
      tab.dataset.clickBound = "true";
      tab.addEventListener("click", () => {
        if (tab.dataset.tab) {
          activateTab(tab.dataset.tab);
          history.replaceState(null, "", `#${tab.dataset.tab}`);
        }
      });
    });
    applyTabFromHash();
  }

  // 同一ページ内でヘッダーの Music / Illust リンク(/gallery#illustration 等)を
  // クリックした場合、ClientRouter が pushState でハッシュのみ更新するため
  // hashchange イベントが発火しない。クリックを直接拾ってタブを切り替える。
  function normalizePathname(pathname: string): string {
    return pathname.replace(/\/+$/, "") || "/";
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const anchor = target?.closest("a");
    if (!anchor || !anchor.hash) {
      return;
    }
    if (
      normalizePathname(anchor.pathname) !==
      normalizePathname(window.location.pathname)
    ) {
      return;
    }
    const tabType = anchor.hash.slice(1);
    const tabs = document.querySelectorAll(
      ".gallery-tab",
    ) as NodeListOf<HTMLElement>;
    const validTabs = Array.from(tabs).map((tab) => tab.dataset.tab);
    if (validTabs.includes(tabType)) {
      activateTab(tabType);
    }
  });

  // ブラウザバック等でハッシュだけ変わった場合にもタブを追従させる
  window.addEventListener("hashchange", applyTabFromHash);

  // astro:page-load は初回ロードと ClientRouter による遷移の両方で、
  // 新しいページのスクリプト読み込み後に発火する。
  // (DOMContentLoaded + astro:after-swap の組み合わせだと、クライアント遷移で
  //  初めてこのスクリプトが読み込まれた場合にどちらも発火済みで初期化されない)
  document.addEventListener("astro:page-load", () => {
    initTabs();
    initializeGalleryReveal();
    initializeVideoFacades();
  });
</script>
