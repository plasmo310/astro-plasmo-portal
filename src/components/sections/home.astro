---
import type { HomeData } from "../../types/data/home";

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
---

<section id="home" class="relative min-h-screen text-center">
  <div class="flex h-[50vh] items-end justify-center px-4 sm:px-8">
    <div class="w-full max-w-4xl pb-6 sm:pb-10">
      <h1
        class="home-title grid w-full grid-cols-[1fr_auto_1fr] items-center text-3xl font-bold sm:text-4xl md:text-5xl lg:text-6xl"
      >
        <span class="text-right">Plasmo</span>
        <span class="lightning-icon mx-2 sm:mx-4 md:mx-6"></span>
        <span class="text-left">Portal！</span>
      </h1>
    </div>
  </div>

  <div
    class="flex h-[50vh] flex-col items-center justify-start px-4 pt-6 sm:px-8 sm:pt-10"
  >
    <div class="w-full max-w-4xl">
      <div
        class="home-intro mb-8 text-[11px] leading-relaxed font-semibold text-white sm:text-xs md:text-sm"
        set:html={data.introHtml}
      />
      <a
        href="#about"
        class="scroll-down-btn mt-4 inline-flex items-center justify-center text-white transition-colors duration-300 hover:text-white"
        aria-label="Scroll down"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-12 w-12"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .home-title {
    color: white;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
  }

  .home-intro {
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }

  .scroll-down-btn {
    animation: bounce-down 1.5s ease-in-out infinite;
  }

  @keyframes bounce-down {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
</style>
