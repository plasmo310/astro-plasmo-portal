---
import SectionHeading from "../common/section-heading.astro";

interface CareerItem {
  company: string;
  role: string;
  period: string;
  description: string;
  skills: string[];
}

interface Props {
  data: CareerItem[];
}

const { data: typedCareerData } = Astro.props;
---

<section id="career">
  <div
    class="bg-background-sub/50 mx-auto my-16 w-[97.5%] max-w-7xl rounded-2xl border border-white/10 px-4 pt-6 pb-12 backdrop-blur-2xl backdrop-saturate-200 sm:px-6 sm:pt-8 sm:pb-16"
  >
    <div class="container mx-auto">
      <SectionHeading title="Career" />

      <div class="relative mx-auto mt-8 max-w-4xl">
        <div
          class="from-accent absolute top-6 bottom-0 left-4 w-0.5 bg-linear-to-b via-white/10 to-transparent md:left-1/2 md:-translate-x-1/2"
        >
        </div>

        {/* Mobile Layout */}
        <div class="space-y-8 md:hidden">
          {
            typedCareerData.map((item, index) => (
              <div class="relative pl-10 text-left">
                <div class="scroll-stat absolute top-1 left-2 z-10">
                  <div
                    class={`border-background-sub h-4 w-4 rounded-full border-4 ${index === 0 ? "bg-accent animate-pulse shadow-[0_0_12px_var(--color-accent)]" : "bg-gray-600"}`}
                  />
                </div>
                <div class="scroll-stat bg-background-sub/70 hover:border-accent/30 rounded-2xl border border-white/10 p-4 transition-all">
                  <span class="text-accent font-mono text-xs tracking-widest uppercase">
                    {item.period}
                  </span>
                  <h4 class="font-heading mt-1 text-base font-bold text-white sm:text-lg">
                    {item.role}
                  </h4>
                  <p class="mb-3 text-sm text-gray-300">{item.company}</p>
                  <p class="mb-3 text-[11px] leading-relaxed text-gray-400 sm:text-sm">
                    {item.description}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {item.skills.map((skill) => (
                      <span class="bg-background-sub/70 rounded-full border border-white/10 px-2 py-1 text-[10px] text-gray-300">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        {/* Desktop Layout (alternating) */}
        <div class="hidden space-y-6 md:block">
          {
            typedCareerData.map((item, index) => (
              <div class="relative grid grid-cols-2 gap-0">
                <div class="scroll-stat absolute top-2 left-1/2 z-10 -translate-x-1/2">
                  <div
                    class={`border-background-sub h-4 w-4 rounded-full border-4 ${index === 0 ? "bg-accent animate-pulse shadow-[0_0_12px_var(--color-accent)]" : "bg-gray-600"}`}
                  />
                </div>
                <div class="pr-10">
                  {index % 2 === 0 ? (
                    <div class="scroll-stat bg-background-sub/70 hover:border-accent/30 group rounded-2xl border border-white/10 p-5 text-right transition-all">
                      <span class="text-accent font-mono text-xs tracking-widest uppercase">
                        {item.period}
                      </span>
                      <h4 class="font-heading mt-1 text-base font-bold text-white sm:text-lg">
                        {item.role}
                      </h4>
                      <p class="mb-3 text-sm text-gray-300">{item.company}</p>
                      <p class="mb-3 text-[11px] leading-relaxed text-gray-400 sm:text-sm">
                        {item.description}
                      </p>
                      <div class="flex flex-wrap justify-end gap-2">
                        {item.skills.map((skill) => (
                          <span class="bg-background-sub/70 group-hover:border-accent/20 rounded-full border border-white/10 px-2 py-1 text-[10px] text-gray-300">
                            {skill}
                          </span>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div class="h-full" />
                  )}
                </div>
                <div class="pl-10">
                  {index % 2 !== 0 ? (
                    <div class="scroll-stat bg-background-sub/70 hover:border-accent/30 group rounded-2xl border border-white/10 p-5 text-left transition-all">
                      <span class="text-accent font-mono text-xs tracking-widest uppercase">
                        {item.period}
                      </span>
                      <h4 class="font-heading mt-1 text-base font-bold text-white sm:text-lg">
                        {item.role}
                      </h4>
                      <p class="mb-3 text-sm text-gray-300">{item.company}</p>
                      <p class="mb-3 text-[11px] leading-relaxed text-gray-400 sm:text-sm">
                        {item.description}
                      </p>
                      <div class="flex flex-wrap gap-2">
                        {item.skills.map((skill) => (
                          <span class="bg-background-sub/70 group-hover:border-accent/20 rounded-full border border-white/10 px-2 py-1 text-[10px] text-gray-300">
                            {skill}
                          </span>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div class="h-full" />
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCareer() {
    const items = document.querySelectorAll("#career .scroll-stat");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(items).indexOf(
              entry.target as HTMLElement,
            );
            setTimeout(
              () => {
                entry.target.classList.add("reveal");
              },
              (index % 3) * 150,
            );
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -10px 0px" },
    );
    items.forEach((el) => observer.observe(el));
  }

  revealCareer();
  document.addEventListener("astro:after-swap", revealCareer);
</script>
