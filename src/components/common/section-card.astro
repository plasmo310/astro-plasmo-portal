---
interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section {id}>
  <div
    class:list={[
      "relative mx-auto my-16 w-[97.5%] max-w-7xl rounded-2xl border border-white/10 pt-6 sm:pt-8",
      className,
    ]}
  >
    {/* すりガラス効果は背景専用レイヤーに分離する。カード本体に backdrop-filter を
        かけると、内側の iframe が Chromium で真っ黒にレンダリングされるため。 */}
    <div
      class="bg-background-sub/50 pointer-events-none absolute inset-0 rounded-2xl backdrop-blur-2xl backdrop-saturate-200"
    >
    </div>
    <div class="relative container mx-auto">
      <slot />
    </div>
  </div>
</section>
