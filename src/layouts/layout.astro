---
import "../styles/global.css";
import ThreeBackground from "../components/common/three-background.astro";
import PageNavigation from "../components/common/page-navigation.astro";
import { ClientRouter } from "astro:transitions";

const homePaths = ["/", "/en", "/en/"];
const isHome = homePaths.includes(Astro.url.pathname);
---

<!doctype html>
<html lang="en" style="background-color: #1a1a1a;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Plasmo Portal</title>
    <ClientRouter />
  </head>
  <body class="bg-background">
    <ThreeBackground showModel={isHome} />
    <main class="relative">
      <slot />
    </main>

    <PageNavigation />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
    overscroll-behavior: none;
  }
</style>
