---
interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<section {id}>
  <div
    class:list={[
      "bg-background-sub/50 mx-auto my-16 w-[97.5%] max-w-7xl rounded-2xl border border-white/10 pt-6 backdrop-blur-2xl backdrop-saturate-200 sm:pt-8",
      className,
    ]}
  >
    <div class="container mx-auto">
      <slot />
    </div>
  </div>
</section>
