---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionCard from "../common/section-card.astro";
import SectionHeading from "../common/section-heading.astro";
import WorksModal from "./works-modal.astro";
import type { Locale } from "../../lib/data-loader";
import type { WorksData } from "../../types/data/works";

interface Props {
  pickupOnly?: boolean;
  locale?: Locale;
  data: WorksData;
}

const { pickupOnly = true, locale = "ja", data: worksData } = Astro.props;
const {
  pickupDescHtml,
  allDescHtml,
  sections: rawSections,
} = worksData as unknown as WorksData;
const worksAllHref = locale === "en" ? "/en/works" : "/works";
const title = pickupOnly ? "Private Works" : "All Private Works";
const currentDescHtml = pickupOnly ? pickupDescHtml : allDescHtml;
const sections = pickupOnly
  ? rawSections
      .map((s) => ({ ...s, works: s.works.filter((w) => w.pickup) }))
      .filter((s) => s.works.length > 0)
  : rawSections;
---

<SectionCard id="works" class="px-6 pb-24">
  <SectionHeading title={title} />
  <p
    class="font-body -mt-4 mb-12 text-xs leading-relaxed text-gray-300 sm:text-sm md:text-base"
    set:html={currentDescHtml}
  />

  {
    pickupOnly && (
      <div class="mt-16 flex justify-end">
        <a
          href={worksAllHref}
          class="group hover:text-accent font-body inline-flex items-center gap-3 text-xl font-semibold tracking-wider text-white transition-colors duration-300"
        >
          All Works
          <Icon
            name="mdi:arrow-right"
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>
    )
  }

  <div class={`space-y-20 ${pickupOnly ? "max-w-6xl mx-auto" : ""}`}>
    {
      sections.map((workSection, si) => (
        <div>
          <h3
            id={`works-${workSection.section.toLowerCase().replace(/[\s/]+/g, "-")}`}
            data-nav-stop
            class="font-heading text-accent mb-3 border-b border-white/10 pb-3 text-lg font-semibold tracking-widest uppercase"
          >
            {workSection.section}
          </h3>
          {workSection.descHtml && (
            <p
              class="font-body mb-8 text-xs leading-relaxed text-gray-400 sm:text-sm"
              set:html={workSection.descHtml}
            />
          )}
          <div
            class={`grid gap-8 ${pickupOnly ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"}`}
          >
            {workSection.works.map((work, wi) => {
              const isSlider = work.images.length > 1;
              const modalId = `work-modal-${si}-${wi}`;
              return (
                <div
                  class="work-card bg-background-sub/70 hover:border-accent/40 flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-white/10 transition-[border-color] duration-500 select-none"
                  data-modal-id={modalId}
                >
                  <div class="bg-background relative aspect-video shrink-0 overflow-hidden">
                    <div class="work-card-overlay pointer-events-none absolute inset-0 z-10 flex items-center justify-center transition-all duration-300">
                      <span class="work-card-detail-label font-body text-sm tracking-widest text-white uppercase opacity-0 transition-opacity duration-300">
                        Show Detail
                      </span>
                    </div>
                    <div
                      class={`relative h-full w-full ${isSlider ? "image-slider" : ""}`}
                    >
                      {work.images.map((image, index) => {
                        let imageSrc = image;
                        if (
                          !image.startsWith("http") &&
                          !image.startsWith("/")
                        ) {
                          imageSrc = `/${image}`;
                        }
                        const isGif = imageSrc.toLowerCase().endsWith(".gif");
                        const className = `work-card-img absolute inset-0 w-full h-full object-cover ${index === 0 ? "opacity-100 z-0" : "opacity-0 z-[-1]"}`;
                        return isGif ? (
                          <img
                            src={imageSrc}
                            alt={`${work.title} screenshot ${index + 1}`}
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                            class={className}
                          />
                        ) : (
                          <Image
                            src={imageSrc}
                            alt={`${work.title} screenshot ${index + 1}`}
                            width={640}
                            height={360}
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                            class={className}
                          />
                        );
                      })}
                    </div>
                  </div>

                  <div class="relative flex flex-1 flex-col p-5 sm:p-6">
                    {work.links.length > 0 && (
                      <div class="absolute top-5 right-5 z-20 flex gap-2">
                        {work.links.map((link) => (
                          <div class="group/tip relative">
                            <a
                              href={link.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="hover:text-accent block text-white/65 transition-colors"
                            >
                              <Icon name={link.icon} class="h-6 w-6" />
                            </a>
                            <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded bg-black/80 px-2 py-1 text-[10px] whitespace-nowrap text-white opacity-0 transition-opacity duration-200 group-hover/tip:opacity-100">
                              {link.tooltip}
                            </span>
                          </div>
                        ))}
                      </div>
                    )}
                    <div class="mb-2">
                      <span class="text-accent text-[10px] font-bold tracking-widest uppercase">
                        {work.category}
                      </span>
                      <h4 class="font-heading mt-1 text-base font-bold text-white sm:text-lg md:text-xl">
                        {work.title}
                      </h4>
                      <p class="font-body mt-1 text-xs tracking-wide text-white/40">
                        {work.period}
                      </p>
                    </div>

                    <p class="font-body line-clamp-3 flex-1 text-xs text-gray-400 sm:text-sm">
                      {work.overview}
                    </p>

                    <div class="mt-auto flex flex-wrap gap-2 pt-4 sm:pt-6">
                      {work.tech.map((t) => (
                        <span class="bg-background-sub/70 rounded-md border border-white/5 px-2 py-1 text-[10px] text-white/60">
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>

  {
    pickupOnly && (
      <div class="mt-16 flex justify-end">
        <a
          href={worksAllHref}
          class="group hover:text-accent font-body inline-flex items-center gap-3 text-xl font-semibold tracking-wider text-white transition-colors duration-300"
        >
          All Works
          <Icon
            name="mdi:arrow-right"
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>
    )
  }
</SectionCard>

{
  sections.map((workSection, si) =>
    workSection.works.map((work, wi) => (
      <WorksModal modalId={`work-modal-${si}-${wi}`} work={work} />
    )),
  )
}

<script>
  // 画像のスライド(切り替え)処理
  function initSliders() {
    const sliders = document.querySelectorAll(".image-slider");
    sliders.forEach((slider) => {
      const images = slider.querySelectorAll("img");
      if (images.length <= 1) {
        return;
      }

      let currentIndex = 0;
      setInterval(() => {
        images[currentIndex].classList.remove("opacity-100", "z-0");
        images[currentIndex].classList.add("opacity-0", "z-[-1]");
        currentIndex = (currentIndex + 1) % images.length;
        images[currentIndex].classList.remove("opacity-0", "z-[-1]");
        images[currentIndex].classList.add("opacity-100", "z-0");
      }, 3500);
    });
  }

  // 画面内に入ったらカードを表示する（4枚ごとにバッチ表示）
  function initReveal() {
    const BATCH_SIZE = 4;
    const batches: HTMLElement[][] = [];

    document.querySelectorAll("#works .grid").forEach((grid) => {
      const cards = Array.from(
        grid.querySelectorAll(".work-card"),
      ) as HTMLElement[];
      for (let i = 0; i < cards.length; i += BATCH_SIZE) {
        batches.push(cards.slice(i, i + BATCH_SIZE));
      }
    });

    // ビューポート手前で画像の先読みだけ行う（表示はしない）
    function preloadBatch(batch: HTMLElement[]) {
      batch.forEach((card) => {
        card.querySelectorAll("img").forEach((image) => {
          const preloader = new Image();
          preloader.src = image.src;
        });
      });
    }

    function revealBatch(batch: HTMLElement[]) {
      batch.forEach((card, i) => {
        setTimeout(() => {
          card.classList.add("reveal");
          card.addEventListener(
            "animationend",
            () => card.classList.remove("reveal-animating"),
            { once: true },
          );
          card.classList.add("reveal-animating");
        }, i * 150);
      });
    }

    // 400px手前で先読み開始
    const preloadObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const anchor = entry.target as HTMLElement;
            const batchIndex = parseInt(anchor.dataset.batchIndex ?? "0");
            preloadObserver.unobserve(anchor);
            preloadBatch(batches[batchIndex]);
          }
        });
      },
      { threshold: 0, rootMargin: "0px 0px 400px 0px" },
    );

    // ビューポートに入ったらカードを表示
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const anchor = entry.target as HTMLElement;
            const batchIndex = parseInt(anchor.dataset.batchIndex ?? "0");
            revealObserver.unobserve(anchor);
            revealBatch(batches[batchIndex]);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -10px 0px" },
    );

    batches.forEach((batch, i) => {
      batch[0].dataset.batchIndex = String(i);
      preloadObserver.observe(batch[0]);
      revealObserver.observe(batch[0]);
    });
  }

  // カードクリックでモーダルを開く
  function initCardClick() {
    const cards = document.querySelectorAll(".work-card");
    cards.forEach((card) => {
      card.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) {
          return;
        }
        const modalId = (card as HTMLElement).dataset.modalId;
        if (!modalId) {
          return;
        }
        const modal = document.getElementById(modalId);
        if (!modal) {
          return;
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      });
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    initSliders();
    initReveal();
    initCardClick();
  });
  document.addEventListener("astro:after-swap", () => {
    initSliders();
    initReveal();
    initCardClick();
  });
</script>

<style is:global>
  .work-card {
    opacity: 0;
    visibility: hidden;
    transition: border-color 0.5s;
  }

  .work-card.reveal {
    opacity: 1;
    visibility: visible;
  }

  @keyframes card-slide-up {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .work-card.reveal-animating {
    animation: card-slide-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .work-card-img {
    transition: transform 0.4s ease;
  }

  .work-card:hover .work-card-img {
    transform: scale(1.02);
  }

  .work-card:hover .work-card-overlay {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .work-card:hover .work-card-detail-label {
    opacity: 1;
  }
</style>
