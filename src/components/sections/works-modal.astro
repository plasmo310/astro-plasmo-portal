---
import { Icon } from "astro-icon/components";
import type { WorksData } from "../../types/data/works";

interface Props {
  modalId: string;
  work: WorksData.Item;
}

const { modalId, work } = Astro.props;
const { category, title, period, descHtml, images, tech, links } = work;
const isSlider = images.length > 1;
---

<div
  id={modalId}
  class="work-modal-overlay fixed inset-0 z-200 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
>
  <div
    class="relative flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#0f0f0f] shadow-2xl"
  >
    <button
      class="work-modal-close absolute top-4 right-4 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white/60 transition-colors hover:bg-white/20 hover:text-white"
      aria-label="Close"
    >
      <Icon name="mdi:close" class="h-5 w-5" />
    </button>

    <div class="bg-background relative aspect-video shrink-0 overflow-hidden">
      <div
        class={`w-full h-full relative ${isSlider ? "modal-image-slider" : ""}`}
      >
        {
          images.map((img, index) => {
            const src =
              img.startsWith("http") || img.startsWith("/") ? img : `/${img}`;
            return (
              <img
                src={src}
                alt={`${title} screenshot ${index + 1}`}
                draggable="false"
                class={`modal-img absolute inset-0 h-full w-full object-cover ${index === 0 ? "z-0 opacity-100" : "z-[-1] opacity-0"}`}
              />
            );
          })
        }
      </div>
    </div>

    <div class="flex flex-col gap-5 overflow-y-auto p-6">
      <div>
        <span
          class="text-accent text-[10px] font-bold tracking-widest uppercase"
        >
          {category}
        </span>
        <h3 class="font-heading mt-1 text-2xl font-bold text-white">
          {title}
        </h3>
        <p class="font-body mt-1 text-xs tracking-wide text-white/40">
          {period}
        </p>
      </div>

      {
        links.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:border-accent/40 hover:text-accent flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-white/60 transition-colors"
              >
                <Icon name={link.icon} class="h-4 w-4 shrink-0" />
                <span>{link.tooltip}</span>
              </a>
            ))}
          </div>
        )
      }

      <p
        class="font-body text-xs leading-relaxed text-gray-400 sm:text-sm"
        set:html={descHtml}
      />

      <div class="flex flex-wrap gap-2 pb-1">
        {
          tech.map((t) => (
            <span class="rounded-md border border-white/5 bg-white/5 px-2 py-1 text-[10px] text-white/60">
              {t}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  function initModals() {
    // モーダル画像スライダー
    document.querySelectorAll(".modal-image-slider").forEach((slider) => {
      const images = slider.querySelectorAll("img");
      if (images.length <= 1) return;
      let idx = 0;
      setInterval(() => {
        images[idx].classList.remove("opacity-100", "z-0");
        images[idx].classList.add("opacity-0", "z-[-1]");
        idx = (idx + 1) % images.length;
        images[idx].classList.remove("opacity-0", "z-[-1]");
        images[idx].classList.add("opacity-100", "z-0");
      }, 3500);
    });

    // オーバーレイクリックで閉じる
    document.querySelectorAll(".work-modal-overlay").forEach((overlay) => {
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal(overlay as HTMLElement);
      });
    });

    // 閉じるボタン
    document.querySelectorAll(".work-modal-close").forEach((btn) => {
      btn.addEventListener("click", () => {
        const overlay = btn.closest(".work-modal-overlay") as HTMLElement;
        if (overlay) closeModal(overlay);
      });
    });

    // Escapeキーで閉じる
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const open = document.querySelector(
          ".work-modal-overlay.flex",
        ) as HTMLElement;
        if (open) closeModal(open);
      }
    });
  }

  function closeModal(overlay: HTMLElement) {
    overlay.classList.remove("flex");
    overlay.classList.add("hidden");
    document.body.style.overflow = "";
  }

  window.addEventListener("load", initModals);
  document.addEventListener("astro:after-swap", initModals);
</script>

<style is:global>
  .modal-img {
    transition: opacity 1s ease;
  }
</style>
