---
import { Icon } from "astro-icon/components";
import SectionHeading from "../common/section-heading.astro";

interface SkillItem {
  name: string;
  level: number;
  icon: string;
}

interface SkillCategory {
  category: string;
  skills: SkillItem[];
}

interface SkillSection {
  section: string;
  categories: SkillCategory[];
}

interface Props {
  data: {
    descHtml: string;
    skill: unknown[];
  };
}

const { data } = Astro.props;
const skillSections: SkillSection[] = data.skill as unknown as SkillSection[];
---

<section id="skills">
  <div
    class="bg-background-sub/50 mx-auto my-16 flex w-[97.5%] max-w-7xl items-start justify-center rounded-2xl border border-white/10 px-6 pt-6 pb-16 text-center backdrop-blur-2xl backdrop-saturate-200 sm:pt-8"
  >
    <div class="container mx-auto">
      <SectionHeading title="Skills" />
      <p
        class="font-body -mt-4 mb-12 text-left text-xs leading-relaxed text-gray-300 sm:text-sm md:text-base"
        set:html={data.descHtml}
      />

      <div class="mx-auto mb-6 flex max-w-6xl justify-end">
        <div
          class="flex flex-col gap-2 rounded-xl border border-white/10 bg-white/5 p-3 sm:flex-row sm:gap-4"
        >
          {
            [
              { label: "Expert", level: 3 },
              { label: "Intermediate", level: 2 },
              { label: "Beginner", level: 1 },
            ].map((item) => (
              <div class="flex items-center gap-2">
                <div class="flex gap-0.5">
                  {[1, 2, 3].map((star) => (
                    <Icon
                      name="mdi:star"
                      class={`h-3 w-3 ${star <= item.level ? "text-accent" : "text-gray-600"}`}
                    />
                  ))}
                </div>
                <span class="text-[10px] tracking-wider text-white/60 uppercase">
                  {item.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mx-auto max-w-6xl space-y-12 text-left">
        {
          skillSections.map((section) => (
            <div>
              <h3
                id={`skills-${section.section.toLowerCase().replace(/[\s/]+/g, "-")}`}
                data-nav-stop
                class="font-heading text-accent mb-8 border-b border-white/10 pb-3 text-lg font-semibold tracking-widest uppercase"
              >
                {section.section}
              </h3>
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                {section.categories.map((cat) => (
                  <div class="skill-card bg-background-sub/70 hover:border-accent/20 rounded-2xl border border-white/10 p-6 transition-all duration-300">
                    <h4 class="mb-4 text-[11px] tracking-[0.4em] text-gray-400 uppercase">
                      {cat.category}
                    </h4>
                    <div class="flex flex-col gap-3">
                      {cat.skills.map((skill) => (
                        <div class="group flex items-center gap-3">
                          <Icon
                            name={skill.icon}
                            class="h-7 w-7 shrink-0 transition-transform duration-300 group-hover:scale-110"
                          />
                          <span class="font-body flex-1 text-sm font-medium text-white/90">
                            {skill.name}
                          </span>
                          <div class="flex shrink-0 gap-0.5">
                            {[1, 2, 3].map((star) => (
                              <Icon
                                name="mdi:star"
                                class={`h-3 w-3 ${star <= skill.level ? "text-accent" : "text-gray-600"}`}
                              />
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .skill-card {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .skill-card.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const scrollStats = document.querySelectorAll("#skills .scroll-stat");
    const observer1 = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(scrollStats).indexOf(
              entry.target as HTMLElement,
            );
            setTimeout(
              () => {
                entry.target.classList.add("reveal");
              },
              (index % 3) * 150,
            );
            observer1.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -10px 0px" },
    );
    scrollStats.forEach((card) => observer1.observe(card));

    const skillCards = document.querySelectorAll(".skill-card");
    const observer2 = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(skillCards).indexOf(
              entry.target as HTMLElement,
            );
            setTimeout(
              () => {
                entry.target.classList.add("reveal");
              },
              (index % 6) * 50,
            );
            observer2.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
    );
    skillCards.forEach((card) => observer2.observe(card));
  }

  revealCards();
  document.addEventListener("astro:after-swap", revealCards);
</script>
