import Works from "../components/sections/works.astro";
import Footer from "../components/sections/footer.astro";

const loader = new DataLoader('ja');
---

<Layout>
  <Header />
  <Works data={loader.works()} locale="ja" pickupOnly={false} />
  <Footer />
</Layout>
