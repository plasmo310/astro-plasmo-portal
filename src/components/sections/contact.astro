---
import { Icon } from "astro-icon/components";
import SectionHeading from "../common/section-heading.astro";

interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ContactData {
  descHtml: string;
  socials: Social[];
}

interface Props {
  data: ContactData;
}

const { data: localData } = Astro.props;
---

<section id="contact">
  <div
    class="bg-background-sub/50 mx-auto my-16 w-[97.5%] max-w-7xl rounded-2xl border border-white/10 px-6 pt-6 pb-10 backdrop-blur-2xl backdrop-saturate-200 sm:pt-8"
  >
    <div class="container mx-auto">
      <SectionHeading title="Contact" />
      <p
        class="font-body -mt-4 mb-6 text-xs leading-relaxed text-gray-300 sm:text-sm md:text-base"
        set:html={localData.descHtml}
      />

      <div class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          localData.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              class="hover:border-accent/40 flex flex-col items-center gap-2 rounded-xl border border-white/10 bg-white/5 p-6 transition-colors"
            >
              <Icon name={social.icon} class="h-8 w-8 text-white" />
              <span class="text-sm font-bold">{social.name}</span>
              <span class="text-xs text-gray-400">
                {social.url.replace("https://", "").replace("mailto:", "")}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
