---
import type { NavData } from "../../types/ui/nav";

const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith("/en");
const locale = isEnglish ? "en" : "ja";

const isIndexPage =
  pathname === "/" || pathname === "/en/" || pathname === "/en";
const anchorBase = isIndexPage ? "" : isEnglish ? "/en/" : "/";

const worksAllHref = isEnglish ? "/en/works" : "/works";
const jaUrl = isEnglish ? pathname.replace(/^\/en/, "") || "/" : pathname;
const enUrl = isEnglish
  ? pathname
  : "/en" + (pathname === "/" ? "/" : pathname);

const navItems: NavData.Item[] = [
  { label: "Home", href: `${anchorBase}#home` },
  { label: "About", href: `${anchorBase}#about` },
  { label: "Career", href: `${anchorBase}#career` },
  {
    label: "Works",
    href: `${anchorBase}#works`,
    children: [{ label: "All Works", href: worksAllHref }],
  },
  { label: "Skills", href: `${anchorBase}#skills` },
  { label: "Blog", href: "https://elekibear.com", newTab: true },
  { label: "Contact", href: `${anchorBase}#contact` },
];

const desktopNavItems = navItems.filter((item) => item.label !== "Career");
---

<div class="flex w-full justify-center">
  <nav
    id="header"
    class="fixed top-0 left-0 z-20 w-full border-b border-transparent transition-all duration-500 ease-in-out"
  >
    <div
      class="reveal-content relative container mx-auto flex items-center justify-center px-6 py-4"
    >
      <!-- Desktop nav -->
      <ul class="hidden justify-center gap-12 space-x-6 lg:flex">
        {
          desktopNavItems.map((item) =>
            item.children ? (
              <li class="group/nav relative">
                <a
                  href={item.href}
                  class="group relative flex items-center gap-1 text-gray-400 transition-colors"
                >
                  {item.label}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3 w-3 transition-transform duration-200 group-hover/nav:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </a>
                <div class="pointer-events-none absolute top-full left-1/2 z-30 -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-200 group-hover/nav:pointer-events-auto group-hover/nav:opacity-100">
                  <ul class="bg-background min-w-35 overflow-hidden rounded-xl border border-white/10">
                    {item.children.map((child) => (
                      <li class="w-full">
                        <a
                          href={child.href}
                          class="hover:text-accent block w-full px-4 py-3 text-sm whitespace-nowrap text-gray-400 transition-colors hover:bg-white/5"
                          target={child.newTab ? "_blank" : undefined}
                          rel={child.newTab ? "noopener noreferrer" : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="group relative flex items-center gap-1 text-gray-400 transition-colors"
                  target={item.newTab ? "_blank" : undefined}
                  rel={item.newTab ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                  {item.newTab && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3 w-3 opacity-60"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  )}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="max-h-0 overflow-hidden border-t border-transparent transition-[max-height] duration-300 ease-in-out lg:hidden"
    >
      <ul class="flex flex-col items-center gap-5 py-4">
        {
          navItems.map((item) =>
            item.children ? (
              <li class="flex flex-col items-center gap-4">
                <a
                  href={item.href}
                  class="mobile-nav-link text-gray-400 transition-colors"
                >
                  {item.label}
                </a>
                <ul class="flex flex-col items-center gap-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="mobile-nav-link text-sm text-gray-600 transition-colors"
                        target={child.newTab ? "_blank" : undefined}
                        rel={child.newTab ? "noopener noreferrer" : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="mobile-nav-link flex items-center gap-1 text-gray-400 transition-colors"
                  target={item.newTab ? "_blank" : undefined}
                  rel={item.newTab ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                  {item.newTab && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-3 w-3 opacity-60"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  )}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </nav>
</div>

<!-- Hamburger button: fixed top-left (mobile only) -->
<div class="drop-shadow-nav fixed top-4 left-4 z-30 lg:hidden">
  <button
    id="hamburger"
    class="relative h-6 w-6 text-white"
    aria-label="メニューを開く"
    aria-expanded="false"
  >
    <!-- 閉じた状態: ☰ -->
    <svg
      id="icon-open"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="absolute inset-0"
    >
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <!-- 開いた状態: × -->
    <svg
      id="icon-close"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="absolute inset-0"
    >
      <line x1="4" y1="4" x2="20" y2="20"></line>
      <line x1="20" y1="4" x2="4" y2="20"></line>
    </svg>
  </button>
</div>

<!-- Language switcher: fixed top-right -->
<div class="drop-shadow-nav fixed top-4 right-4 z-30">
  <a
    id="lang-switcher-link"
    href={locale === "ja" ? enUrl : jaUrl}
    class="lang-switcher text-sm font-bold tracking-widest"
    aria-label={locale === "ja" ? "Switch to English" : "日本語に切り替え"}
    data-ja-url={jaUrl}
    data-en-url={enUrl}
  >
    <span id="lang-jp" class={locale === "ja" ? "lang-active" : "lang-inactive"}
      >JP</span
    >
    <span class="lang-sep">|</span>
    <span id="lang-en" class={locale === "en" ? "lang-active" : "lang-inactive"}
      >EN</span
    >
  </a>
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 4px;
    transition: opacity 0.2s ease;
  }

  .lang-switcher:hover {
    opacity: 0.8;
  }

  .lang-active {
    color: white;
  }

  .lang-inactive {
    color: rgba(255, 255, 255, 0.35);
  }

  .lang-sep {
    color: rgba(255, 255, 255, 0.3);
  }

  nav {
    border-color: transparent;
    backdrop-filter: blur(0px);
    background-color: transparent;
  }

  nav.menu-open {
    background-color: var(--color-background);
  }

  nav a {
    transition:
      transform 0.3s ease,
      color 0.3s ease,
      font-weight 0.3s ease;
  }

  nav a.active {
    color: white !important;
    font-weight: 700;
    transform: scale(1.1);
  }

  nav a.active span {
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  nav li {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  nav a:not(.active):hover {
    color: var(--color-accent) !important;
  }

  nav a:not(.active):hover span {
    transform: scale(0.95);
    text-shadow: 0 0 15px var(--color-accent-60);
  }

  #mobile-menu.open {
    max-height: 500px;
  }

  #icon-open,
  #icon-close {
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  #icon-open {
    opacity: 1;
    transform: scale(1);
  }
  #icon-close {
    opacity: 0;
    transform: scale(0.5);
  }

  #hamburger.open #icon-open {
    opacity: 0;
    transform: scale(0.5);
  }
  #hamburger.open #icon-close {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  let rafId: number | null = null;

  function updateNav() {
    const navElement = document.getElementById("header");
    if (window.scrollY > 0) {
      navElement?.classList.add("scrolling");
    } else {
      navElement?.classList.remove("scrolling");
    }
    rafId = null;
  }

  function setMenuOpen(open: boolean) {
    const navElement = document.getElementById("header");
    const hamburger = document.getElementById("hamburger");
    const mobileMenu = document.getElementById("mobile-menu");
    mobileMenu?.classList.toggle("open", open);
    hamburger?.classList.toggle("open", open);
    hamburger?.setAttribute("aria-expanded", String(open));
    navElement?.classList.toggle("menu-open", open);
  }

  function updateLangSwitcher() {
    const isEn = window.location.pathname.startsWith("/en");
    const link = document.getElementById(
      "lang-switcher-link",
    ) as HTMLAnchorElement | null;
    const jpSpan = document.getElementById("lang-jp");
    const enSpan = document.getElementById("lang-en");
    if (!link || !jpSpan || !enSpan) {
      return;
    }
    const jaUrl = link.dataset.jaUrl ?? "/";
    const enUrl = link.dataset.enUrl ?? "/en/";
    link.href = isEn ? jaUrl : enUrl;
    jpSpan.className = isEn ? "lang-inactive" : "lang-active";
    enSpan.className = isEn ? "lang-active" : "lang-inactive";
  }

  function setupPage() {
    const navElement = document.getElementById("header");
    const hamburger = document.getElementById("hamburger");
    const mobileMenu = document.getElementById("mobile-menu");

    hamburger?.addEventListener("click", () => {
      const isOpen = !mobileMenu?.classList.contains("open");
      setMenuOpen(isOpen);
    });

    // 項目クリック時: 対象セクションへ移動する
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (event) {
        event.preventDefault();
        const target = event.currentTarget as HTMLAnchorElement;
        const targetId = target.getAttribute("href")?.substring(1) || "";
        const targetElement = document.getElementById(targetId);

        const isMenuOpen = mobileMenu?.classList.contains("open") ?? false;
        if (isMenuOpen) {
          setMenuOpen(false);
        }

        if (targetElement) {
          const doScroll = () => {
            const headerHeight = navElement?.offsetHeight ?? 0;
            const top =
              targetElement.getBoundingClientRect().top +
              window.scrollY -
              headerHeight;
            window.scrollTo({ top, behavior: "smooth" });
          };
          if (isMenuOpen) {
            setTimeout(doScroll, 300);
          } else {
            doScroll();
          }
        }
      });
    });

    // 各セクションの表示状態監視
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a[href^='#']");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => link.classList.remove("active"));
            const id = entry.target.getAttribute("id");
            document
              .querySelector(`nav a[href="#${id}"]`)
              ?.classList.add("active");
          }
        });
      },
      { threshold: 0, rootMargin: "0px 0px -80% 0px" },
    );
    sections.forEach((section) => observer.observe(section));

    updateLangSwitcher();
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true },
  );

  document.addEventListener("astro:page-load", setupPage);
</script>
