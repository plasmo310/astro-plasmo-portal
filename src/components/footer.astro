---

<footer
  class="relative flex flex-col items-center justify-center h-16  bg-dark-gray"
>
  <a
    href="#home"
    id="scroll-top"
    aria-label="Back to top"
    class="absolute -top-10 flex items-center justify-center w-32 h-20 rounded-t-full bg-dark-gray"
  >
    <span class="absolute top-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="80"
        height="80"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"></path>
      </svg>
    </span>
  </a>
  <div class="w-full px-8">
    <p class="text-sm text-gray-400">© 2026 Plasmo</p>
  </div>
</footer>

<style>
  #scroll-top {
    color: var(--color-accent);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  #scroll-top:hover {
    transform: translateY(-3px);
  }
</style>
