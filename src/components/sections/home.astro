---
import localData from "../../data/home.json";
---

<section
  id="home"
  class="flex items-center justify-center min-h-screen text-center"
>
  <div class="w-full px-4 sm:px-8 max-w-4xl mx-auto">
    <h1
      class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold grid grid-cols-[1fr_auto_1fr] items-center w-full"
    >
      <span class="text-right">Plasmo</span>
      <span class="lightning-icon mx-2 sm:mx-4 md:mx-6"></span>
      <span class="text-left">Portal！</span>
    </h1>
    <div
      class="mt-8 md:mt-12 mb-8 text-gray-400 text-sm sm:text-base leading-relaxed"
      set:html={localData.introHtml}
    />

    <a
      href="#about"
      class="inline-flex items-center justify-center mt-4 text-gray-400 hover:text-white transition-colors duration-300 scroll-down-btn"
      aria-label="Scroll down"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-12 h-12"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .scroll-down-btn {
    animation: bounce-down 1.5s ease-in-out infinite;
  }

  @keyframes bounce-down {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
</style>
