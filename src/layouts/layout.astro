---
import "../styles/global.css";
import ThreeBackground from "../components/common/three-background.astro";
import PageNavigation from "../components/common/page-navigation.astro";
import { ClientRouter } from "astro:transitions";
import {
  isHomePath,
  MODEL_GLB_PATH,
  MODEL_TEXTURE_PATH,
} from "../lib/three-background-assets";

// モデルを表示するページでのみ先読みする。three.js のチャンク取得と
// パースを待たずにモデルのダウンロードを始めるための指定。
const shouldPreloadModel = isHomePath(Astro.url.pathname);
---

<!doctype html>
<html lang="en" style="background-color: #1a1a1a;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {
      shouldPreloadModel && (
        <>
          <link
            rel="preload"
            href={MODEL_GLB_PATH}
            as="fetch"
            type="model/gltf-binary"
            crossorigin="anonymous"
          />
          {/* three.js の TextureLoader は crossOrigin="anonymous" で取得するため、
              preload 側も揃えないと二重ダウンロードになる */}
          <link
            rel="preload"
            href={MODEL_TEXTURE_PATH}
            as="image"
            crossorigin="anonymous"
          />
        </>
      )
    }
    <title>Plasmo Portal</title>
    <ClientRouter />
  </head>
  <body class="bg-background">
    <ThreeBackground />
    <main class="relative">
      <slot />
    </main>

    <PageNavigation />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
    overscroll-behavior: none;
  }
</style>
