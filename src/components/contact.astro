---
import { Icon } from "astro-icon/components";
import SectionHeading from "./SectionHeading.astro";
import localData from "../data/about.json";
---

<section
  id="contact"
  class="flex items-start justify-center text-center px-6 py-16"
>
  <div class="container mx-auto">
    <SectionHeading title="Contact" />
    <div class="flex flex-wrap justify-center gap-6 my-8">
      {
        localData.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            class="flex flex-col items-center gap-2 p-6 border border-white/10 rounded-xl hover:border-accent/40 transition-colors w-60 bg-white/5"
          >
            <Icon name={social.icon} class="w-8 h-8 text-accent" />
            <span class="text-sm font-bold">{social.name}</span>
            <span class="text-xs text-gray-400">
              {social.url
                .replace("https://", "")
                .replace("mailto:", "")}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
