---
import SectionHeading from "../common/section-heading.astro";

interface CareerItem {
  company: string;
  role: string;
  period: string;
  description: string;
  skills: string[];
}

interface Props {
  data: CareerItem[];
}

const { data: typedCareerData } = Astro.props;
---

<section id="career">
  <div
    class="px-4 sm:px-6 pt-6 sm:pt-8 pb-12 sm:pb-16 bg-background-sub/50 backdrop-blur-2xl backdrop-saturate-200 border border-white/10 w-[97.5%] max-w-[1280px] mx-auto my-16 rounded-2xl"
  >
    <div class="container mx-auto">
      <SectionHeading title="Career" />

      <div class="relative max-w-4xl mx-auto mt-8">
        <div
          class="absolute left-4 md:left-1/2 md:-translate-x-1/2 top-6 bottom-0 w-0.5 bg-gradient-to-b from-accent via-white/10 to-transparent"
        >
        </div>

        {/* Mobile Layout */}
        <div class="md:hidden space-y-8">
          {
            typedCareerData.map((item, index) => (
              <div class="relative pl-10 text-left">
                <div class="scroll-stat absolute left-2 top-1 z-10">
                  <div
                    class={`w-4 h-4 rounded-full border-4 border-background-sub ${index === 0 ? "bg-accent shadow-[0_0_12px_theme(colors.accent)] animate-pulse" : "bg-gray-600"}`}
                  />
                </div>
                <div class="scroll-stat bg-background-sub/70 border border-white/10 p-4 rounded-2xl hover:border-accent/30 transition-all">
                  <span class="text-accent font-mono text-xs tracking-widest uppercase">
                    {item.period}
                  </span>
                  <h4 class="text-base sm:text-lg font-heading font-bold text-white mt-1">
                    {item.role}
                  </h4>
                  <p class="text-gray-300 text-sm mb-3">{item.company}</p>
                  <p class="text-gray-400 text-[11px] sm:text-sm leading-relaxed mb-3">
                    {item.description}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {item.skills.map((skill) => (
                      <span class="px-2 py-1 bg-background-sub/70 border border-white/10 rounded-full text-[10px] text-gray-300">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        {/* Desktop Layout (alternating) */}
        <div class="hidden md:block space-y-6">
          {
            typedCareerData.map((item, index) => (
              <div class="relative grid grid-cols-2 gap-0">
                <div class="scroll-stat absolute left-1/2 -translate-x-1/2 top-2 z-10">
                  <div
                    class={`w-4 h-4 rounded-full border-4 border-background-sub ${index === 0 ? "bg-accent shadow-[0_0_12px_theme(colors.accent)] animate-pulse" : "bg-gray-600"}`}
                  />
                </div>
                <div class="pr-10">
                  {index % 2 === 0 ? (
                    <div class="scroll-stat bg-background-sub/70 border border-white/10 p-5 rounded-2xl text-right hover:border-accent/30 transition-all group">
                      <span class="text-accent font-mono text-xs tracking-widest uppercase">
                        {item.period}
                      </span>
                      <h4 class="text-base sm:text-lg font-heading font-bold text-white mt-1">
                        {item.role}
                      </h4>
                      <p class="text-gray-300 text-sm mb-3">{item.company}</p>
                      <p class="text-gray-400 text-[11px] sm:text-sm leading-relaxed mb-3">
                        {item.description}
                      </p>
                      <div class="flex flex-wrap gap-2 justify-end">
                        {item.skills.map((skill) => (
                          <span class="px-2 py-1 bg-background-sub/70 border border-white/10 rounded-full text-[10px] text-gray-300 group-hover:border-accent/20">
                            {skill}
                          </span>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div class="h-full" />
                  )}
                </div>
                <div class="pl-10">
                  {index % 2 !== 0 ? (
                    <div class="scroll-stat bg-background-sub/70 border border-white/10 p-5 rounded-2xl text-left hover:border-accent/30 transition-all group">
                      <span class="text-accent font-mono text-xs tracking-widest uppercase">
                        {item.period}
                      </span>
                      <h4 class="text-base sm:text-lg font-heading font-bold text-white mt-1">
                        {item.role}
                      </h4>
                      <p class="text-gray-300 text-sm mb-3">{item.company}</p>
                      <p class="text-gray-400 text-[11px] sm:text-sm leading-relaxed mb-3">
                        {item.description}
                      </p>
                      <div class="flex flex-wrap gap-2">
                        {item.skills.map((skill) => (
                          <span class="px-2 py-1 bg-background-sub/70 border border-white/10 rounded-full text-[10px] text-gray-300 group-hover:border-accent/20">
                            {skill}
                          </span>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div class="h-full" />
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCareer() {
    const items = document.querySelectorAll("#career .scroll-stat");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(items).indexOf(
              entry.target as HTMLElement,
            );
            setTimeout(
              () => {
                entry.target.classList.add("reveal");
              },
              (index % 3) * 150,
            );
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -10px 0px" },
    );
    items.forEach((el) => observer.observe(el));
  }

  revealCareer();
  document.addEventListener("astro:after-swap", revealCareer);
</script>
