---

<footer
  id="footer"
  class="bg-dark-gray relative flex h-16 flex-col items-center justify-center"
>
  <button
    id="scroll-top"
    aria-label="Back to top"
    class="bg-dark-gray absolute -top-8 flex h-16 w-24 cursor-pointer items-center justify-center rounded-t-full sm:-top-10 sm:h-20 sm:w-32"
  >
    <span class="absolute top-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="72"
        height="72"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"></path>
      </svg>
    </span>
  </button>
  <div class="w-full px-4 sm:px-8">
    <p class="text-xs text-gray-400 sm:text-sm">© 2026 Plasmo</p>
  </div>
</footer>

<style>
  #scroll-top {
    color: var(--color-accent);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  #scroll-top:hover {
    transform: translateY(-3px);
  }
</style>

<script>
  function setupFooter() {
    document.getElementById("scroll-top")?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
  document.addEventListener("astro:page-load", setupFooter);
</script>
