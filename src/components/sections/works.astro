---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionHeading from "../common/section-heading.astro";
import WorksModal from "./works-modal.astro";
import worksData from "../../data/works.json";

interface Props {
  pickupOnly?: boolean;
}

interface WorkLink {
  icon: string;
  tooltip: string;
  href: string;
}

interface Work {
  pickup?: boolean;
  category: string;
  title: string;
  period: string;
  overview: string;
  descHtml: string;
  images: string[];
  tech: string[];
  links: WorkLink[];
}

interface WorkSection {
  section: string;
  works: Work[];
}

interface WorksData {
  pickupDescHtml: string;
  allDescHtml: string;
  sections: WorkSection[];
}

const { pickupOnly = true } = Astro.props;
const {
  pickupDescHtml,
  allDescHtml,
  sections: rawSections,
} = worksData as unknown as WorksData;
const title = pickupOnly ? "Pickup Works" : "All Works";
const currentDescHtml = pickupOnly ? pickupDescHtml : allDescHtml;
const sections = pickupOnly
  ? rawSections
      .map((s) => ({ ...s, works: s.works.filter((w) => w.pickup) }))
      .filter((s) => s.works.length > 0)
  : rawSections;
---

<section id="works">
  <div
    class="px-6 pt-6 sm:pt-8 pb-24 bg-background-sub/50 backdrop-blur-2xl backdrop-saturate-200 border border-white/10 w-[97.5%] max-w-[1280px] mx-auto my-16 rounded-2xl"
  >
    <div class="container mx-auto">
      <SectionHeading title={title} />
      <p
        class="text-gray-300 font-body text-xs sm:text-sm md:text-base mb-12 -mt-4 leading-relaxed"
        set:html={currentDescHtml}
      />

      {
        pickupOnly && (
          <div class="mt-16 flex justify-end">
            <a
              href="/works"
              class="group inline-flex items-center gap-3 text-xl text-white hover:text-accent transition-colors duration-300 font-body tracking-wider font-semibold"
            >
              All Works
              <Icon
                name="mdi:arrow-right"
                class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
              />
            </a>
          </div>
        )
      }

      <div class={`space-y-20 ${pickupOnly ? "max-w-6xl mx-auto" : ""}`}>
        {
          sections.map((workSection, si) => (
            <div>
              <h3
                id={`works-${workSection.section.toLowerCase().replace(/[\s/]+/g, '-')}`}
                data-nav-stop
                class="text-lg font-heading font-semibold text-accent mb-8 tracking-widest uppercase border-b border-white/10 pb-3"
              >
                {workSection.section}
              </h3>
              <div
                class={`grid gap-8 ${pickupOnly ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"}`}
              >
                {workSection.works.map((work, wi) => {
                  const isSlider = work.images.length > 1;
                  const modalId = `work-modal-${si}-${wi}`;
                  return (
                    <div
                      class="work-card cursor-pointer bg-background-sub/70 border border-white/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-[border-color] duration-500 flex flex-col select-none"
                      data-modal-id={modalId}
                    >
                      <div class="aspect-video overflow-hidden relative bg-[#1a1a1a] shrink-0">
                        <div class="work-card-overlay absolute inset-0 transition-all duration-300 z-10 pointer-events-none flex items-center justify-center">
                          <span class="work-card-detail-label opacity-0 text-white text-sm font-body tracking-widest uppercase transition-opacity duration-300">
                            Show Detail
                          </span>
                        </div>
                        <div
                          class={`w-full h-full relative ${isSlider ? "image-slider" : ""}`}
                        >
                          {work.images.map((img, index) => {
                            const src = img.startsWith("http")
                              ? img
                              : `/${img}`;
                            const isGif = src.toLowerCase().endsWith(".gif");
                            const cls = `work-card-img absolute inset-0 w-full h-full object-cover ${index === 0 ? "opacity-100 z-0" : "opacity-0 z-[-1]"}`;
                            return isGif ? (
                              <img
                                src={src}
                                alt={`${work.title} screenshot ${index + 1}`}
                                loading="lazy"
                                decoding="async"
                                draggable="false"
                                class={cls}
                              />
                            ) : (
                              <Image
                                src={src}
                                alt={`${work.title} screenshot ${index + 1}`}
                                width={640}
                                height={360}
                                loading="lazy"
                                decoding="async"
                                draggable="false"
                                class={cls}
                              />
                            );
                          })}
                        </div>
                      </div>

                      <div class="p-5 sm:p-6 flex flex-col flex-1 relative">
                        {work.links.length > 0 && (
                          <div class="absolute top-5 right-5 flex gap-2 z-20">
                            {work.links.map((link) => (
                              <div class="relative group/tip">
                                <a
                                  href={link.href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="text-white/65 hover:text-accent transition-colors block"
                                >
                                  <Icon name={link.icon} class="w-6 h-6" />
                                </a>
                                <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded bg-black/80 text-white text-[10px] whitespace-nowrap opacity-0 group-hover/tip:opacity-100 transition-opacity duration-200">
                                  {link.tooltip}
                                </span>
                              </div>
                            ))}
                          </div>
                        )}
                        <div class="mb-2">
                          <span class="text-accent text-[10px] uppercase tracking-widest font-bold">
                            {work.category}
                          </span>
                          <h4 class="text-base sm:text-lg md:text-xl font-heading font-bold text-white mt-1">
                            {work.title}
                          </h4>
                          <p class="text-white/40 text-xs font-body mt-1 tracking-wide">
                            {work.period}
                          </p>
                        </div>

                        <p class="text-gray-400 text-xs sm:text-sm font-body line-clamp-3 flex-1">
                          {work.overview}
                        </p>

                        <div class="flex flex-wrap gap-2 pt-4 sm:pt-6 mt-auto">
                          {work.tech.map((t) => (
                            <span class="px-2 py-1 bg-background-sub/70 rounded-md text-[10px] text-white/60 border border-white/5">
                              {t}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>

      {
        pickupOnly && (
          <div class="mt-16 flex justify-end">
            <a
              href="/works"
              class="group inline-flex items-center gap-3 text-xl text-white hover:text-accent transition-colors duration-300 font-body tracking-wider font-semibold"
            >
              All Works
              <Icon
                name="mdi:arrow-right"
                class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
              />
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

{
  sections.map((workSection, si) =>
    workSection.works.map((work, wi) => (
      <WorksModal
        modalId={`work-modal-${si}-${wi}`}
        category={work.category}
        title={work.title}
        period={work.period}
        descHtml={work.descHtml}
        images={work.images}
        tech={work.tech}
        links={work.links}
      />
    )),
  )
}

<script>
  // 画像のスライド(切り替え)処理
  function initSliders() {
    const sliders = document.querySelectorAll(".image-slider");
    sliders.forEach((slider) => {
      const images = slider.querySelectorAll("img");
      if (images.length <= 1) return;

      let currentIndex = 0;
      setInterval(() => {
        images[currentIndex].classList.remove("opacity-100", "z-0");
        images[currentIndex].classList.add("opacity-0", "z-[-1]");
        currentIndex = (currentIndex + 1) % images.length;
        images[currentIndex].classList.remove("opacity-0", "z-[-1]");
        images[currentIndex].classList.add("opacity-100", "z-0");
      }, 3500);
    });
  }

  // 画面内に入ったらカードを表示する（4枚ごとにバッチ表示）
  function initReveal() {
    const BATCH_SIZE = 4;
    const batches: HTMLElement[][] = [];

    document.querySelectorAll("#works .grid").forEach((grid) => {
      const cards = Array.from(
        grid.querySelectorAll(".work-card"),
      ) as HTMLElement[];
      for (let i = 0; i < cards.length; i += BATCH_SIZE) {
        batches.push(cards.slice(i, i + BATCH_SIZE));
      }
    });

    // ビューポート手前で画像の先読みだけ行う（表示はしない）
    function preloadBatch(batch: HTMLElement[]) {
      batch.forEach((card) => {
        card.querySelectorAll("img").forEach((img) => {
          const preloader = new Image();
          preloader.src = img.src;
        });
      });
    }

    function revealBatch(batch: HTMLElement[]) {
      batch.forEach((card, i) => {
        setTimeout(() => card.classList.add("reveal"), i * 150);
      });
    }

    // 400px手前で先読み開始
    const preloadObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const anchor = entry.target as HTMLElement;
            const batchIndex = parseInt(anchor.dataset.batchIndex ?? "0");
            preloadObserver.unobserve(anchor);
            preloadBatch(batches[batchIndex]);
          }
        });
      },
      { threshold: 0, rootMargin: "0px 0px 400px 0px" },
    );

    // ビューポートに入ったらカードを表示
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const anchor = entry.target as HTMLElement;
            const batchIndex = parseInt(anchor.dataset.batchIndex ?? "0");
            revealObserver.unobserve(anchor);
            revealBatch(batches[batchIndex]);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -10px 0px" },
    );

    batches.forEach((batch, i) => {
      batch[0].dataset.batchIndex = String(i);
      preloadObserver.observe(batch[0]);
      revealObserver.observe(batch[0]);
    });
  }

  // カードクリックでモーダルを開く
  function initCardClick() {
    const cards = document.querySelectorAll(".work-card");
    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) return;
        const modalId = (card as HTMLElement).dataset.modalId;
        if (!modalId) return;
        const modal = document.getElementById(modalId);
        if (!modal) return;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      });
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    initSliders();
    initReveal();
    initCardClick();
  });
  document.addEventListener("astro:after-swap", () => {
    initSliders();
    initReveal();
    initCardClick();
  });
</script>

<style is:global>
  .work-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s,
      border-color 0.5s;
    will-change: transform, opacity;
  }

  .work-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }

  .work-card-img {
    transition:
      opacity 1s ease,
      transform 0.4s ease;
  }

  .work-card:hover .work-card-img {
    transform: scale(1.02);
  }

  .work-card:hover .work-card-overlay {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .work-card:hover .work-card-detail-label {
    opacity: 1;
  }
</style>
