---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SectionCard from "../common/section-card.astro";
import SectionHeading from "../common/section-heading.astro";
import type { Locale } from "../../lib/data-loader";
import type { GalleryData } from "../../types/data/gallery";

interface Props {
  locale?: Locale;
  data: GalleryData;
}

const { locale = "ja", data } = Astro.props;
const galleryAllHref = locale === "en" ? "/en/gallery" : "/gallery";

const musicCategory = data.categories.find(
  (category) => category.type === "music",
);
const illustCategory = data.categories.find(
  (category) => category.type === "illustration",
);

const pickupMusicItems = (musicCategory?.sections ?? []).flatMap((section) =>
  section.items.filter((item) => item.pickup),
);
const pickupIllustItems = (illustCategory?.sections ?? []).flatMap((section) =>
  section.items.filter((item) => item.pickup),
);

function getMusicThumbnail(item: GalleryData.Item): string {
  if (item.image) {
    return item.image;
  }
  if (item.embedUrl) {
    const match = item.embedUrl.match(/embed\/([^?]+)/);
    if (match) {
      return `https://img.youtube.com/vi/${match[1]}/hqdefault.jpg`;
    }
  }
  return "https://placehold.co/400x400/1a1a2e/a0a0c0?text=Music";
}

// 動画項目は embedUrl から YouTube 視聴リンクを自動生成し、他サービスのリンクと並べる。
function getItemLinks(item: GalleryData.Item): GalleryData.Link[] {
  const links = item.links ? [...item.links] : [];
  if (item.embedType === "video" && item.embedUrl) {
    const match = item.embedUrl.match(/embed\/([^?&]+)/);
    if (match) {
      links.push({
        icon: "fa-brands:youtube",
        tooltip: "YouTube",
        href: `https://www.youtube.com/watch?v=${match[1]}`,
      });
    }
  }
  return links;
}
---

<SectionCard id="gallery" class="px-6 pb-24">
  <SectionHeading title="Gallery" />
  <p
    class="font-body -mt-4 mb-8 text-xs leading-relaxed text-gray-300 sm:text-sm md:text-base"
    set:html={data.pickupDescHtml}
  />

  <div class="mt-8 flex justify-end">
    <a
      href={galleryAllHref}
      class="group hover:text-accent font-body inline-flex items-center gap-3 text-xl font-semibold tracking-wider text-white transition-colors duration-300"
    >
      All Gallery
      <Icon
        name="mdi:arrow-right"
        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-12 sm:grid-cols-2">
    <!-- Music Column -->
    <div>
      <h3
        class="font-heading text-accent mb-6 border-b border-white/10 pb-3 text-lg font-semibold tracking-widest uppercase"
      >
        {musicCategory?.label ?? "Music"}
      </h3>
      <div class="space-y-4">
        {
          pickupMusicItems.map((item) => {
            const thumbnail = getMusicThumbnail(item);
            return (
              <div
                class="gallery-card bg-background-sub/70 hover:border-accent/40 overflow-hidden rounded-2xl border border-white/10 transition-[border-color] duration-500"
                style={item.maxWidth ? { maxWidth: item.maxWidth } : {}}
              >
                {item.embedType === "video" ? (
                  <div class="relative aspect-video w-full">
                    <button
                      class="video-facade group/video absolute inset-0 h-full w-full cursor-pointer"
                      data-embed-url={item.embedUrl}
                      aria-label={`Play ${item.title}`}
                    >
                      <img
                        src={thumbnail}
                        alt={item.title}
                        loading="lazy"
                        class="absolute inset-0 h-full w-full object-cover"
                      />
                      <span class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors duration-200 group-hover/video:bg-black/30">
                        <Icon
                          name="mdi:play-circle"
                          class="h-16 w-16 text-white/90 drop-shadow-lg transition-transform duration-200 group-hover/video:scale-110"
                        />
                      </span>
                    </button>
                  </div>
                ) : item.embedType === "apple-music-player" ? (
                  <div class="w-full overflow-hidden">
                    <iframe
                      src={item.embedUrl}
                      title={item.title}
                      class="w-full"
                      style={{ height: "450px" }}
                      frameborder="0"
                      allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
                      sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
                    />
                  </div>
                ) : (
                  <div class="bg-background overflow-hidden">
                    <img
                      src={thumbnail}
                      alt={item.title}
                      loading="lazy"
                      class="h-auto w-full"
                    />
                  </div>
                )}
                <div class="p-4">
                  <p class="font-body text-xs tracking-wide text-white/40">
                    {item.year}
                  </p>
                  <h4 class="font-heading mt-1 text-sm font-bold text-white sm:text-base">
                    {item.title}
                  </h4>
                  {getItemLinks(item).length > 0 && (
                    <div class="mt-3 flex gap-3">
                      {getItemLinks(item).map((link) => (
                        <div class="group/tip relative">
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-accent block text-white/65 transition-colors"
                          >
                            <Icon name={link.icon} class="h-5 w-5" />
                          </a>
                          <span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 rounded bg-black/80 px-2 py-1 text-[10px] whitespace-nowrap text-white opacity-0 transition-opacity duration-200 group-hover/tip:opacity-100">
                            {link.tooltip}
                          </span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Illust Column -->
    <div>
      <h3
        class="font-heading text-accent mb-6 border-b border-white/10 pb-3 text-lg font-semibold tracking-widest uppercase"
      >
        {illustCategory?.label ?? "Illust"}
      </h3>
      <div class="space-y-4">
        {
          pickupIllustItems.map((item) => {
            const image =
              item.image ??
              "https://placehold.co/400x500/1a1a2e/a0a0c0?text=Illustration";
            return (
              <div
                class="gallery-card bg-background-sub/70 hover:border-accent/40 overflow-hidden rounded-2xl border border-white/10 transition-[border-color] duration-500"
                style={item.maxWidth ? { maxWidth: item.maxWidth } : {}}
              >
                <div class="bg-background overflow-hidden">
                  <img
                    src={image}
                    alt={item.title}
                    loading="lazy"
                    class="h-auto w-full"
                  />
                </div>
                <div class="p-3">
                  <p class="font-body text-[10px] tracking-wide text-white/40">
                    {item.year}
                  </p>
                  <h4 class="font-heading mt-0.5 text-sm font-bold text-white">
                    {item.title}
                  </h4>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="mt-16 flex justify-end">
    <a
      href={galleryAllHref}
      class="group hover:text-accent font-body inline-flex items-center gap-3 text-xl font-semibold tracking-wider text-white transition-colors duration-300"
    >
      All Gallery
      <Icon
        name="mdi:arrow-right"
        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </div>
</SectionCard>

<style is:global>
  .gallery-card {
    opacity: 0;
    visibility: hidden;
    transition: border-color 0.5s;
  }

  .gallery-card.reveal {
    opacity: 1;
    visibility: visible;
  }

  @keyframes gallery-card-slide-up {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .gallery-card.reveal-animating {
    animation: gallery-card-slide-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>

<script>
  // 生の YouTube iframe は初期フレームが真っ黒に描画される環境があるため、
  // 初期はサムネイル画像を表示し、クリックで埋め込み URL のプレイヤーを読み込む。
  function initVideoFacades() {
    const facades = document.querySelectorAll(
      "#gallery .video-facade",
    ) as NodeListOf<HTMLElement>;

    facades.forEach((facade) => {
      facade.addEventListener(
        "click",
        () => {
          const embedUrl = facade.dataset.embedUrl;
          if (!embedUrl) {
            return;
          }
          const separator = embedUrl.includes("?") ? "&" : "?";
          const iframe = document.createElement("iframe");
          iframe.src = `${embedUrl}${separator}autoplay=1`;
          iframe.title = facade.getAttribute("aria-label") ?? "";
          iframe.className = "absolute inset-0 h-full w-full";
          iframe.setAttribute("frameborder", "0");
          iframe.setAttribute(
            "allow",
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
          );
          iframe.setAttribute(
            "referrerpolicy",
            "strict-origin-when-cross-origin",
          );
          iframe.setAttribute("allowfullscreen", "");
          facade.replaceWith(iframe);
        },
        { once: true },
      );
    });
  }

  function initReveal() {
    const cards = Array.from(
      document.querySelectorAll("#gallery .gallery-card"),
    ) as HTMLElement[];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target as HTMLElement;
            observer.unobserve(card);
            card.classList.add("reveal");
            card.addEventListener(
              "animationend",
              () => card.classList.remove("reveal-animating"),
              { once: true },
            );
            card.classList.add("reveal-animating");
          }
        });
      },
      { threshold: 0.1 },
    );

    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener("DOMContentLoaded", () => {
    initReveal();
    initVideoFacades();
  });
  document.addEventListener("astro:after-swap", () => {
    initReveal();
    initVideoFacades();
  });
</script>
