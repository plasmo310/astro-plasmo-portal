<canvas
  id="three-bg"
  transition:persist="three-background"
  class="pointer-events-none fixed inset-0 h-full w-full"
  style="z-index: 0;"></canvas>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { MeshoptDecoder } from "three/addons/libs/meshopt_decoder.module.js";
  import {
    isHomePath,
    MODEL_GLB_PATH,
    MODEL_TEXTURE_PATH,
  } from "../../lib/three-background-assets";

  // モデル(エレキベア)はトップページでのみ表示する。
  // canvas は transition:persist でページ間を持ち越されるため、
  // 表示可否はレンダリング時の属性ではなく現在のパスから毎回判定する。

  // WebGL コンテキストの生成は環境により一時的に失敗することがあるため、
  // 失敗時は少し待ってからリトライする(初期表示で背景が出ない事象への対策)。
  const RENDERER_RETRY_LIMIT = 3;
  const RENDERER_RETRY_DELAY_MS = 500;

  // ディゾルブパラメータ
  const DISSOLVE_DURATION = 800;
  const NOISE_SCALE = 20;
  const NOISE_TEX_SIZE = 32;
  const NOISE_OFFSET_X = 0.8;
  const NOISE_OFFSET_Y = 0.5;

  function isHomePage(): boolean {
    return isHomePath(window.location.pathname);
  }

  // ディゾルブ用スムーズノイズテクスチャ
  function createNoiseTexture() {
    const size = NOISE_TEX_SIZE;
    const noiseCanvas = document.createElement("canvas");
    noiseCanvas.width = noiseCanvas.height = size;
    const context = noiseCanvas.getContext("2d")!;
    const imageData = context.createImageData(size, size);
    const hash = (a: number, b: number) =>
      Math.abs(Math.sin(a * 127.1 + b * 311.7) * 43758.5453) % 1;
    for (let y = 0; y < size; y++) {
      for (let x = 0; x < size; x++) {
        const gridX = (x / size) * NOISE_SCALE,
          gridY = (y / size) * NOISE_SCALE;
        const integerX = Math.floor(gridX),
          integerY = Math.floor(gridY);
        const fractionX = gridX - integerX,
          fractionY = gridY - integerY;
        const smoothX = fractionX * fractionX * (3 - 2 * fractionX),
          smoothY = fractionY * fractionY * (3 - 2 * fractionY);
        const value =
          hash(integerX, integerY) * (1 - smoothX) * (1 - smoothY) +
          hash(integerX + 1, integerY) * smoothX * (1 - smoothY) +
          hash(integerX, integerY + 1) * (1 - smoothX) * smoothY +
          hash(integerX + 1, integerY + 1) * smoothX * smoothY;
        const index = (y * size + x) * 4;
        const color = Math.floor(value * 255);
        imageData.data[index] =
          imageData.data[index + 1] =
          imageData.data[index + 2] =
            color;
        imageData.data[index + 3] = 255;
      }
    }
    context.putImageData(imageData, 0, 0);
    const texture = new THREE.CanvasTexture(noiseCanvas);
    texture.wrapS = texture.wrapT = THREE.RepeatWrapping;
    texture.offset.set(NOISE_OFFSET_X, NOISE_OFFSET_Y);
    return texture;
  }

  function startBackground(
    canvasElement: HTMLCanvasElement,
    attempt: number,
  ): void {
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas: canvasElement,
        antialias: true,
        alpha: true,
      });
    } catch (error) {
      if (attempt < RENDERER_RETRY_LIMIT) {
        setTimeout(
          () => startBackground(canvasElement, attempt + 1),
          RENDERER_RETRY_DELAY_MS,
        );
      } else {
        console.error("three-background: WebGLレンダラーの作成に失敗", error);
      }
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      45,
      window.innerWidth / window.innerHeight,
      0.1,
      1000,
    );
    camera.position.set(0, 0, 5);
    camera.lookAt(0, 0, 0);

    // ライト
    scene.add(new THREE.AmbientLight(0xffffff, 1));
    const directionalLightTarget = new THREE.Object3D();
    scene.add(directionalLightTarget);
    const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
    directionalLight.target = directionalLightTarget;
    directionalLight.position.set(10, 10, 8.5);
    scene.add(directionalLight);
    const pointLight = new THREE.PointLight(0xffd400, 2, 12);
    pointLight.position.set(3, 3, 3);
    scene.add(pointLight);

    const noiseTexture = createNoiseTexture();

    let loadModelRoot: THREE.Group | null = null;
    let animationMixer: THREE.AnimationMixer | null = null;
    let dissolveMaterial: THREE.MeshToonMaterial | null = null;
    let dissolveStartTime: number | null = null;
    let modelRequested = false;
    let modelReady = false;

    // 描画を止めている間も、状態が変わった直後の 1 フレームだけは描画する
    let idleRenderPending = true;

    function startDissolve(): void {
      if (dissolveMaterial) {
        dissolveMaterial.alphaTest = 0.999;
        dissolveStartTime = performance.now();
      }
    }

    async function loadModel(): Promise<void> {
      // GLB とテクスチャは互いに依存しないため並列に取得する。
      // 直列にすると GLB の読み込みが終わるまでテクスチャの通信が始まらない。
      // GLB は EXT_meshopt_compression / KHR_mesh_quantization で圧縮されている
      const gltfLoader = new GLTFLoader().setMeshoptDecoder(MeshoptDecoder);
      const loaded = await Promise.all([
        gltfLoader.loadAsync(MODEL_GLB_PATH),
        new THREE.TextureLoader().loadAsync(MODEL_TEXTURE_PATH),
      ]).catch((error) => {
        console.error("three-background: モデルの読み込みに失敗", error);
        return null;
      });
      if (loaded === null) {
        return;
      }
      const [gltf, texture] = loaded;

      const model = gltf.scene;
      loadModelRoot = new THREE.Group();
      loadModelRoot.add(model);
      loadModelRoot.visible = false;
      loadModelRoot.position.set(0, -1.2, 0);
      loadModelRoot.scale.set(1.5, 1.5, 1.5);
      scene.add(loadModelRoot);

      texture.colorSpace = THREE.SRGBColorSpace;
      texture.flipY = false;

      const material = new THREE.MeshToonMaterial({
        map: texture,
        alphaMap: noiseTexture,
        alphaTest: 0.999,
      });
      dissolveMaterial = material;

      model.traverse((child) => {
        if ((child as THREE.Mesh).isMesh) {
          (child as THREE.Mesh).material = material;
        }
      });

      animationMixer = new THREE.AnimationMixer(model);
      if (gltf.animations.length > 0) {
        const action = animationMixer.clipAction(gltf.animations[0], model);
        action.setLoop(THREE.LoopPingPong, Infinity);
        action.play();
      }

      modelReady = true;
      await renderer.compileAsync(scene, camera);

      if (isHomePage()) {
        loadModelRoot.visible = true;
        startDissolve();
      }
    }

    // ページ遷移のたびに現在のパスからモデルの表示可否を更新する
    function updateModelForPage(): void {
      // 表示状態が変わりうるため、描画を止めていても 1 フレームは描き直す
      idleRenderPending = true;
      if (isHomePage()) {
        if (!modelRequested) {
          modelRequested = true;
          loadModel();
        } else if (loadModelRoot && modelReady && !loadModelRoot.visible) {
          loadModelRoot.visible = true;
          startDissolve();
        }
      } else if (loadModelRoot) {
        loadModelRoot.visible = false;
      }
    }

    document.addEventListener("astro:page-load", updateModelForPage);
    updateModelForPage();

    // パーティクル
    const particleCount = 400;
    const positions = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 16;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 16;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 8;
    }
    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute(
      "position",
      new THREE.BufferAttribute(positions, 3),
    );
    const particleMaterial = new THREE.PointsMaterial({
      color: 0xffd400,
      size: 0.05,
      transparent: true,
      opacity: 0.6,
    });
    const particles = new THREE.Points(particleGeometry, particleMaterial);
    scene.add(particles);

    let previousWidth = window.innerWidth;

    function resizeRenderer(): void {
      previousWidth = window.innerWidth;
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      // リサイズで描画内容が破棄されるため、止めていても描き直す
      idleRenderPending = true;
    }

    window.addEventListener("resize", () => {
      if (window.innerWidth === previousWidth) {
        return;
      }
      resizeRenderer();
    });

    window.addEventListener("orientationchange", () => {
      setTimeout(resizeRenderer, 200);
    });

    // アニメーションループ
    let rotationY = 0;
    let previousTime = performance.now();

    function animate() {
      requestAnimationFrame(animate);
      const now = performance.now();

      // タブが非表示のとき、およびモデルを出さないページでは毎フレームの
      // 描画を行わない。復帰時に delta が跳ねてアニメーションが飛ばないよう、
      // 時刻だけは進めておく。
      if (document.hidden || !isHomePage()) {
        previousTime = now;
        if (idleRenderPending) {
          idleRenderPending = false;
          renderer.render(scene, camera);
        }
        return;
      }
      idleRenderPending = true;

      const delta = (now - previousTime) / 1000;
      const elapsedSeconds = now / 1000;
      previousTime = now;

      animationMixer?.update(delta);

      if (dissolveMaterial !== null && dissolveStartTime !== null) {
        const progress = Math.min(
          (now - dissolveStartTime) / DISSOLVE_DURATION,
          1.0,
        );
        const eased = progress * progress * (3.0 - 2.0 * progress);
        dissolveMaterial.alphaTest = Math.max(1.0 - eased, 0.001);
        if (progress >= 1.0) {
          // マテリアルは再表示時のディゾルブ再生に使うため保持する
          dissolveStartTime = null;
        }
      }

      if (loadModelRoot) {
        rotationY += delta * 0.5;
        loadModelRoot.rotation.y = rotationY;
      }

      particles.rotation.y = elapsedSeconds * 0.04;
      particles.rotation.x = elapsedSeconds * 0.02;
      pointLight.position.x = Math.sin(elapsedSeconds * 0.7) * 4;
      pointLight.position.y = Math.cos(elapsedSeconds * 0.5) * 4;

      renderer.render(scene, camera);
    }
    animate();
  }

  const canvas = document.getElementById(
    "three-bg",
  ) as HTMLCanvasElement | null;
  if (canvas) {
    startBackground(canvas, 0);
  }
</script>
