---
interface Props {
  showModel?: boolean;
}
const { showModel = true } = Astro.props;
---

<canvas
  id="three-bg"
  class="fixed inset-0 w-full h-full pointer-events-none"
  data-show-model={showModel ? "true" : "false"}
  style="z-index: 0;"></canvas>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

  const canvas = document.getElementById("three-bg") as HTMLCanvasElement;
  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: true,
    alpha: true,
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(
    45,
    window.innerWidth / window.innerHeight,
    0.1,
    1000,
  );
  camera.position.set(0, 0, 5);
  camera.lookAt(0, 0, 0);

  // ライト
  scene.add(new THREE.AmbientLight(0xffffff, 1));
  const dirLightTarget = new THREE.Object3D();
  scene.add(dirLightTarget);
  const dirLight = new THREE.DirectionalLight(0xffffff, 1);
  dirLight.target = dirLightTarget;
  dirLight.position.set(10, 10, 8.5);
  scene.add(dirLight);
  const pointLight = new THREE.PointLight(0xffd400, 2, 12);
  pointLight.position.set(3, 3, 3);
  scene.add(pointLight);

  let animMixer: THREE.AnimationMixer | null = null;
  let elekibearRoot: THREE.Group | null = null;
  let dissolveMat: THREE.MeshToonMaterial | null = null;
  let dissolveStartTime: number | null = null;

  // ディゾルブパラメータ
  const DISSOLVE_DURATION = 800;
  const NOISE_SCALE = 20;
  const NOISE_TEX_SIZE = 32;
  const NOISE_OFFSET_X = 0.8;
  const NOISE_OFFSET_Y = 0.5;

  // ディゾルブ用スムーズノイズテクスチャ
  function createNoiseTexture() {
    const size = NOISE_TEX_SIZE;
    const cv = document.createElement("canvas");
    cv.width = cv.height = size;
    const ctx = cv.getContext("2d")!;
    const img = ctx.createImageData(size, size);
    const h = (a: number, b: number) =>
      Math.abs(Math.sin(a * 127.1 + b * 311.7) * 43758.5453) % 1;
    for (let y = 0; y < size; y++) {
      for (let x = 0; x < size; x++) {
        const gx = (x / size) * NOISE_SCALE,
          gy = (y / size) * NOISE_SCALE;
        const ix = Math.floor(gx),
          iy = Math.floor(gy);
        const fx = gx - ix,
          fy = gy - iy;
        const sfx = fx * fx * (3 - 2 * fx),
          sfy = fy * fy * (3 - 2 * fy);
        const v =
          h(ix, iy) * (1 - sfx) * (1 - sfy) +
          h(ix + 1, iy) * sfx * (1 - sfy) +
          h(ix, iy + 1) * (1 - sfx) * sfy +
          h(ix + 1, iy + 1) * sfx * sfy;
        const i = (y * size + x) * 4;
        const c = Math.floor(v * 255);
        img.data[i] = img.data[i + 1] = img.data[i + 2] = c;
        img.data[i + 3] = 255;
      }
    }
    ctx.putImageData(img, 0, 0);
    const tex = new THREE.CanvasTexture(cv);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    tex.offset.set(NOISE_OFFSET_X, NOISE_OFFSET_Y);
    return tex;
  }
  const noiseTex = createNoiseTexture();

  const showModel = canvas.dataset.showModel === "true";

  const gltfLoader = new GLTFLoader();
  if (showModel)
    gltfLoader.load(
      "/model/SM_Elekibear.glb",
      (gltf) => {
        const model = gltf.scene;
        elekibearRoot = new THREE.Group();
        elekibearRoot.add(model);
        elekibearRoot.visible = false;
        elekibearRoot.position.set(0, -1.2, 0);
        elekibearRoot.scale.set(1.5, 1.5, 1.5);
        scene.add(elekibearRoot);

        new THREE.TextureLoader()
          .loadAsync("/model/T_Elekibear.png")
          .then(async (tex) => {
            tex.colorSpace = THREE.SRGBColorSpace;
            tex.flipY = false;

            const mat = new THREE.MeshToonMaterial({
              map: tex,
              alphaMap: noiseTex,
              alphaTest: 0.999,
            });
            dissolveMat = mat;

            model.traverse((child) => {
              if ((child as THREE.Mesh).isMesh) {
                console.log("mesh:", child.name);
                (child as THREE.Mesh).material = mat;
              }
            });

            if (elekibearRoot) elekibearRoot.visible = true;
            await renderer.compileAsync(scene, camera);

            dissolveStartTime = performance.now();
          });

        animMixer = new THREE.AnimationMixer(gltf.scene);
        if (gltf.animations.length > 0) {
          const action = animMixer.clipAction(gltf.animations[0], gltf.scene);
          action.setLoop(THREE.LoopPingPong, Infinity);
          action.play();
        }
      },
      undefined,
      (error) => console.error("load error:", error),
    );

  // パーティクル
  const particleCount = 400;
  const positions = new Float32Array(particleCount * 3);
  for (let i = 0; i < particleCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 16;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 16;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 8;
  }
  const particleGeo = new THREE.BufferGeometry();
  particleGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
  const particleMat = new THREE.PointsMaterial({
    color: 0xffd400,
    size: 0.05,
    transparent: true,
    opacity: 0.6,
  });
  const particles = new THREE.Points(particleGeo, particleMat);
  scene.add(particles);

  let prevWidth = window.innerWidth;

  window.addEventListener("resize", () => {
    if (window.innerWidth === prevWidth) return;
    prevWidth = window.innerWidth;
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  window.addEventListener("orientationchange", () => {
    setTimeout(() => {
      prevWidth = window.innerWidth;
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }, 200);
  });

  // アニメーションループ
  let rotY = 0;
  let prevTime = performance.now();

  function animate() {
    requestAnimationFrame(animate);
    const now = performance.now();
    const delta = (now - prevTime) / 1000;
    const t = now / 1000;
    prevTime = now;

    animMixer?.update(delta);

    if (dissolveMat !== null && dissolveStartTime !== null) {
      const progress = Math.min(
        (now - dissolveStartTime) / DISSOLVE_DURATION,
        1.0,
      );
      const eased = progress * progress * (3.0 - 2.0 * progress);
      dissolveMat.alphaTest = Math.max(1.0 - eased, 0.001);
      if (progress >= 1.0) {
        dissolveMat = null;
        dissolveStartTime = null;
      }
    }

    if (elekibearRoot) {
      rotY += delta * 0.5;
      elekibearRoot.rotation.y = rotY;
    }

    particles.rotation.y = t * 0.04;
    particles.rotation.x = t * 0.02;
    pointLight.position.x = Math.sin(t * 0.7) * 4;
    pointLight.position.y = Math.cos(t * 0.5) * 4;

    renderer.render(scene, camera);
  }
  animate();
</script>
