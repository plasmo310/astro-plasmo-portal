---
interface NavChild {
  label: string;
  href: string;
  newTab?: boolean;
}

interface NavItem {
  label: string;
  href: string;
  newTab?: boolean;
  children?: NavChild[];
}

const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith('/en');
const locale = isEnglish ? 'en' : 'ja';

const isIndexPage = pathname === '/' || pathname === '/en/' || pathname === '/en';
const anchorBase = isIndexPage ? '' : (isEnglish ? '/en/' : '/');

const worksAllHref = isEnglish ? '/en/works' : '/works';
const jaUrl = isEnglish ? (pathname.replace(/^\/en/, '') || '/') : pathname;
const enUrl = isEnglish ? pathname : ('/en' + (pathname === '/' ? '/' : pathname));

const navItems: NavItem[] = [
  { label: 'Home', href: `${anchorBase}#home` },
  { label: 'About', href: `${anchorBase}#about` },
  {
    label: 'Works',
    href: `${anchorBase}#works`,
    children: [{ label: 'All Works', href: worksAllHref }],
  },
  { label: 'Career', href: `${anchorBase}#career` },
  { label: 'Skills', href: `${anchorBase}#skills` },
  { label: 'Blog', href: 'https://elekibear.com', newTab: true },
  { label: 'Contact', href: `${anchorBase}#contact` },
];
---

<div class="flex justify-center w-full">
  <nav
    id="header"
    class="fixed top-0 left-0 z-20 w-full border-b border-transparent transition-all duration-500 ease-in-out"
  >
    <div
      class="container mx-auto relative flex justify-center items-center py-4 px-6 reveal-content"
    >
      <!-- Desktop nav -->
      <ul class="hidden md:flex space-x-6 justify-center gap-12">
        {
          navItems.map((item) =>
            item.children ? (
              <li class="relative group/nav">
                <a
                  href={item.href}
                  class="text-gray-400 transition-colors relative group flex items-center gap-1"
                >
                  {item.label}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-3 h-3 transition-transform duration-200 group-hover/nav:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </a>
                <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 pointer-events-none group-hover/nav:opacity-100 group-hover/nav:pointer-events-auto transition-opacity duration-200 z-30">
                  <ul class="min-w-[140px] bg-background border border-white/10 rounded-xl overflow-hidden">
                    {item.children.map((child) => (
                      <li class="w-full">
                        <a
                          href={child.href}
                          class="block w-full px-4 py-3 text-sm text-gray-400 hover:text-accent hover:bg-white/5 transition-colors whitespace-nowrap"
                          target={child.newTab ? "_blank" : undefined}
                          rel={child.newTab ? "noopener noreferrer" : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="text-gray-400 transition-colors relative group"
                  target={item.newTab ? "_blank" : undefined}
                  rel={item.newTab ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <!-- Language switcher (top right, always visible) -->
      <div class="absolute right-4 flex items-center" style="filter: drop-shadow(0 1px 4px rgba(0,0,0,0.8));">
        <a
          href={locale === 'ja' ? enUrl : jaUrl}
          class="text-white hover:text-accent transition-colors text-sm font-bold tracking-widest"
          aria-label={locale === 'ja' ? 'Switch to English' : '日本語に切り替え'}
        >{locale === 'ja' ? 'EN' : 'JA'}</a>
      </div>

      <!-- Hamburger button (mobile only) -->
      <button
        id="hamburger"
        class="md:hidden text-white absolute left-4 w-6 h-6"
        style="filter: drop-shadow(0 1px 4px rgba(0,0,0,0.8)); opacity: 0.95;"
        aria-label="メニューを開く"
        aria-expanded="false"
      >
        <!-- 閉じた状態: ☰ -->
        <svg
          id="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="absolute inset-0"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <!-- 開いた状態: × -->
        <svg
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="absolute inset-0"
        >
          <line x1="4" y1="4" x2="20" y2="20"></line>
          <line x1="20" y1="4" x2="4" y2="20"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out border-t border-transparent"
    >
      <ul class="flex flex-col items-center py-4 gap-5">
        {
          navItems.map((item) =>
            item.children ? (
              <li class="flex flex-col items-center gap-4">
                <a
                  href={item.href}
                  class="mobile-nav-link text-gray-400 transition-colors"
                >
                  {item.label}
                </a>
                <ul class="flex flex-col items-center gap-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="mobile-nav-link text-sm text-gray-600 transition-colors"
                        target={child.newTab ? "_blank" : undefined}
                        rel={child.newTab ? "noopener noreferrer" : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="mobile-nav-link text-gray-400 transition-colors"
                  target={item.newTab ? "_blank" : undefined}
                  rel={item.newTab ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </nav>
</div>

<style>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  nav {
    border-color: transparent;
    backdrop-filter: blur(0px);
    background-color: transparent;
  }

  nav.menu-open {
    background-color: var(--color-background);
  }

  nav a {
    transition:
      transform 0.3s ease,
      color 0.3s ease,
      font-weight 0.3s ease;
  }

  nav a.active {
    color: white !important;
    font-weight: 700;
    transform: scale(1.1);
  }

  nav a.active span {
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  nav li {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  nav a:not(.active):hover {
    color: var(--color-accent) !important;
  }

  nav a:not(.active):hover span {
    transform: scale(0.95);
    text-shadow: 0 0 15px var(--color-accent-60);
  }

  #mobile-menu.open {
    max-height: 300px;
  }

  #icon-open,
  #icon-close {
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  #icon-open {
    opacity: 1;
    transform: scale(1);
  }
  #icon-close {
    opacity: 0;
    transform: scale(0.5);
  }

  #hamburger.open #icon-open {
    opacity: 0;
    transform: scale(0.5);
  }
  #hamburger.open #icon-close {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  const nav = document.getElementById("header");
  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobile-menu");
  let rafId: number | null = null;

  function updateNav() {
    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true },
  );

  function setMenuOpen(open: boolean) {
    mobileMenu?.classList.toggle("open", open);
    hamburger?.classList.toggle("open", open);
    hamburger?.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("menu-open", open);
  }

  hamburger?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("open");
    setMenuOpen(isOpen);
  });

  // 項目クリック時: 対象セクションへ移動する
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const targetId = target.getAttribute("href")?.substring(1) || "";
      const targetElement = document.getElementById(targetId);

      const isMenuOpen = mobileMenu?.classList.contains("open") ?? false;
      if (isMenuOpen) {
        setMenuOpen(false);
      }

      if (targetElement) {
        const doScroll = () => {
          const headerHeight = nav?.offsetHeight ?? 0;
          const top =
            targetElement.getBoundingClientRect().top +
            window.scrollY -
            headerHeight;
          window.scrollTo({ top, behavior: "smooth" });
        };
        // モバイルメニューが開いていた場合、閉じるトランジション(300ms)を待つ
        if (isMenuOpen) {
          setTimeout(doScroll, 300);
        } else {
          doScroll();
        }
      }
    });
  });

  // 各セクションの表示状態監視: 対応するナビリンクをアクティブにする
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("nav a[href^='#']");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => link.classList.remove("active"));
            const id = entry.target.getAttribute("id");
            document
              .querySelector(`nav a[href="#${id}"]`)
              ?.classList.add("active");
          }
        });
      },
      { threshold: 0, rootMargin: "0px 0px -80% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
